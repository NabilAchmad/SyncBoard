<!DOCTYPE html>
<html lang="id" class="<%= theme_html_class %>" data-theme-preference="<%= theme_preference %>">
  <head>
    <title><%= content_for(:title) || "SyncBoard | Masuk Workspace" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <%= render "shared/head_assets" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-canvas font-sans text-on-surface antialiased" data-controller="theme">
    <main class="flex min-h-screen w-full items-center justify-center p-4 sm:p-6">
      <div class="w-full <%= content_for(:auth_max_width) || 'max-w-[380px]' %> space-y-4">
        <%= render "shared/flash_messages" %>
        <%= yield %>
      </div>
    </main>
  </body>
</html>
