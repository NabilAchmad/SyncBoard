<!DOCTYPE html>
<html lang="id">
  <head>
    <title><%= content_for(:title) || "SyncBoard — Masuk Workspace Tim" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-slate-100 text-slate-900 antialiased">
    <div class="grid min-h-screen lg:grid-cols-12">
      <!-- Panel Kiri SyncBoard -->
      <div class="relative hidden overflow-hidden bg-slate-950 p-12 text-white lg:col-span-5 lg:flex lg:flex-col">
        <!-- Aksen cahaya halus -->
        <div class="pointer-events-none absolute -top-24 -left-24 h-80 w-80 rounded-full bg-indigo-600/20 blur-3xl"></div>
        <div class="pointer-events-none absolute -right-24 -bottom-24 h-80 w-80 rounded-full bg-indigo-500/10 blur-3xl"></div>

        <!-- Brand -->
        <div class="relative flex items-center gap-3">
          <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-600 text-base font-extrabold shadow-sm ring-1 ring-white/10">SB</span>
          <div>
            <p class="text-lg font-bold tracking-tight">SyncBoard</p>
            <p class="text-xs text-slate-400">Team Workspace</p>
          </div>
        </div>

        <!-- Penjelasan Singkat -->
        <div class="relative my-auto max-w-md py-12">
          <h1 class="text-3xl font-bold leading-snug tracking-tight text-white">
            Dari diskusi rapat,<br>
            langsung jadi aksi.
          </h1>

          <p class="mt-4 text-sm leading-relaxed text-slate-400">
            Satu ruang kerja untuk video meeting, notulensi otomatis, dan pembaruan Kanban tim secara real-time.
          </p>

          <ul class="mt-8 space-y-3.5 border-t border-slate-800/80 pt-8 text-sm text-slate-300">
            <li class="flex items-center gap-3">
              <span class="inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-indigo-500/15 text-indigo-400 ring-1 ring-indigo-500/30">
                <svg class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
                </svg>
              </span>
              <span>Video call &amp; screen share terintegrasi</span>
            </li>
            <li class="flex items-center gap-3">
              <span class="inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-indigo-500/15 text-indigo-400 ring-1 ring-indigo-500/30">
                <svg class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
                </svg>
              </span>
              <span>Rangkuman &amp; usulan task otomatis</span>
            </li>
            <li class="flex items-center gap-3">
              <span class="inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-indigo-500/15 text-indigo-400 ring-1 ring-indigo-500/30">
                <svg class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
                </svg>
              </span>
              <span>Sinkronisasi Kanban seketika setelah ACC</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Panel Kanan Form -->
      <div class="flex items-center justify-center p-6 sm:p-10 lg:col-span-7">
        <div class="w-full max-w-md">
          <div class="mb-6 flex items-center gap-2.5 lg:hidden">
            <span class="inline-flex h-9 w-9 items-center justify-center rounded-xl bg-indigo-600 text-sm font-extrabold text-white">SB</span>
            <span class="text-base font-bold text-slate-900">SyncBoard</span>
          </div>

          <%= render "shared/flash_messages" %>
          <%= yield %>
        </div>
      </div>
    </div>
  </body>
</html>
