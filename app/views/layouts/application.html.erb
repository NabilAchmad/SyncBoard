<!DOCTYPE html>
<html lang="id" class="<%= theme_html_class %>" data-theme-preference="<%= theme_preference %>">
  <head>
    <title><%= content_for(:title) || "SyncBoard | Team Workspace" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="SyncBoard">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <%= render "shared/head_assets" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-canvas font-sans text-on-surface antialiased overflow-x-hidden"
        data-controller="sidebar theme"
        data-action="keydown.window->sidebar#handleKeydown"
        data-user-role="<%= current_team ? (current_team_membership&.role || 'member') : 'guest' %>">
    <div class="flex min-h-screen">
      <div data-sidebar-target="backdrop"
           data-action="click->sidebar#close"
           class="fixed inset-0 z-40 hidden bg-black/50 lg:hidden"></div>

      <aside data-sidebar-target="panel"
             aria-label="Navigasi Workspace"
             class="fixed inset-y-0 left-0 z-50 flex w-64 lg:w-[220px] -translate-x-full flex-col border-r border-outline-variant bg-sidebar text-on-surface shadow-lg transition-transform duration-200 lg:translate-x-0 lg:shadow-none shrink-0">
        <div class="flex h-14 shrink-0 items-center justify-between gap-2 border-b border-outline-variant px-3">
          <% if authenticated? && current_team %>
            <details class="group relative min-w-0 flex-1">
              <summary class="flex min-h-11 sm:min-h-9 cursor-pointer list-none items-center justify-between gap-2 rounded-[8px] px-1.5 py-1 text-left transition hover:bg-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary">
                <span class="flex min-w-0 items-center gap-2">
                  <%= brand_logo(size_class: "h-8 w-8") %>
                  <span class="min-w-0">
                    <span class="block truncate font-display text-[13px] font-semibold leading-tight text-on-surface"><%= current_team.name %></span>
                    <span class="block truncate text-[10px] text-on-surface-muted"><%= current_team_lead? ? "Team Lead" : "Member" %></span>
                  </span>
                </span>
                <%= material_icon("unfold_more", size: 16, extra_class: "text-on-surface-muted") %>
              </summary>

              <div class="absolute left-0 right-0 top-full z-50 mt-1.5 rounded-[12px] border border-outline-variant bg-panel p-2 shadow-lg space-y-2">
                <% if current_team_lead? %>
                  <div class="flex items-center justify-between gap-2 rounded-[8px] border border-outline-variant bg-inset px-2 py-1.5">
                    <span class="font-mono text-[11px] font-semibold tracking-widest text-on-surface"><%= current_team.invite_code %></span>
                    <button type="button"
                            data-action="sidebar#copyCode"
                            data-code="<%= current_team.invite_code %>"
                            class="rounded px-1.5 py-0.5 text-[11px] font-semibold text-primary-text hover:bg-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary cursor-pointer">
                      Salin
                    </button>
                  </div>
                <% end %>

                <% if available_teams.size > 1 %>
                  <div class="space-y-1">
                    <p class="px-1.5 text-[10px] font-semibold uppercase tracking-wider text-on-surface-muted">Ganti Tim</p>
                    <% available_teams.each do |team| %>
                      <% next if team.id == current_team.id %>
                      <%= button_to team.name, switch_team_path(team),
                        method: :post,
                        class: "w-full min-h-9 truncate rounded-[8px] border border-outline-variant bg-card px-2 py-1 text-left text-xs font-medium text-on-surface-variant hover:border-outline hover:bg-hover hover:text-on-surface transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary cursor-pointer" %>
                    <% end %>
                  </div>
                <% end %>

                <%= link_to "Kelola / Gabung Tim", teams_path, class: "flex min-h-9 items-center justify-center rounded-[8px] border border-outline-variant bg-card px-2.5 py-1 text-xs font-semibold text-primary-text hover:bg-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary" %>
              </div>
            </details>
          <% else %>
            <%= link_to root_path, class: "flex min-h-11 sm:min-h-9 items-center gap-2 rounded-[8px] px-1.5 py-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary" do %>
              <%= brand_logo(size_class: "h-8 w-8") %>
              <span class="font-display text-[13px] font-semibold text-on-surface">SyncBoard</span>
            <% end %>
          <% end %>

          <button type="button"
                  data-action="sidebar#close"
                  aria-label="Tutup menu navigasi"
                  class="inline-flex h-11 w-11 items-center justify-center rounded-[8px] text-on-surface-muted hover:bg-hover hover:text-on-surface focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary lg:hidden cursor-pointer">
            <%= material_icon("close", size: 18) %>
          </button>
        </div>

        <div class="no-scrollbar flex-1 overflow-y-auto px-2.5 py-3 space-y-4">
          <% active_projects = sidebar_active_projects %>

          <% if authenticated? && current_team && active_projects.any? %>
            <div>
              <label for="sidebar_project_search" class="sr-only">Cari proyek aktif</label>
              <div class="relative flex items-center rounded-[8px] border border-outline-variant bg-card focus-within:border-primary focus-within:ring-2 focus-within:ring-primary/25">
                <%= material_icon("search", size: 15, extra_class: "ml-2.5 text-on-surface-muted") %>
                <input id="sidebar_project_search"
                       type="search"
                       data-sidebar-target="searchInput"
                       data-action="input->sidebar#filterProjects"
                       placeholder="Cari proyek..."
                       class="w-full min-w-0 bg-transparent px-2 py-1.5 text-xs text-on-surface placeholder:text-on-surface-muted focus:outline-none">
                <kbd class="mr-2 hidden rounded border border-outline-variant bg-inset px-1 py-0.5 font-mono text-[10px] text-on-surface-muted lg:inline-block">⌘K</kbd>
              </div>
            </div>
          <% end %>

          <nav class="space-y-0.5" aria-label="Menu utama">
            <%= link_to root_path, class: sidebar_link_class(root_path) do %>
              <%= material_icon("grid_view", size: 18) %>
              <span>Workspace</span>
            <% end %>

            <%= link_to teams_path, class: sidebar_link_class(teams_path) do %>
              <%= material_icon("groups", size: 18) %>
              <span>Tim &amp; Undangan</span>
            <% end %>

            <% if current_team && current_team_lead? %>
              <%= link_to team_members_path, class: sidebar_link_class(team_members_path) do %>
                <%= material_icon("manage_accounts", size: 18) %>
                <span>Kelola Anggota</span>
              <% end %>
            <% end %>
          </nav>

          <% if authenticated? && current_team %>
            <div class="pt-1">
              <div class="mb-1.5 flex items-center justify-between px-2">
                <p class="text-[11px] font-semibold uppercase tracking-wider text-on-surface-muted">Proyek</p>
                <%= link_to new_project_path,
                  aria: { label: "Buat proyek baru" },
                  title: "Buat Proyek Baru",
                  class: "inline-flex h-6 w-6 items-center justify-center rounded-[6px] text-on-surface-muted hover:bg-hover hover:text-on-surface focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary" do %>
                  <%= material_icon("add", size: 16) %>
                <% end %>
              </div>

              <% if active_projects.any? %>
                <nav class="space-y-0.5" aria-label="Daftar proyek">
                  <% active_projects.each do |sidebar_project| %>
                    <% active_nav = current_page?(project_path(sidebar_project)) %>
                    <%= link_to project_path(sidebar_project),
                      data: { sidebar_target: "projectItem", search_text: "#{sidebar_project.key} #{sidebar_project.name}" },
                      class: sidebar_link_class(project_path(sidebar_project)) do %>
                      <span class="h-1.5 w-1.5 shrink-0 rounded-full <%= active_nav ? 'bg-primary' : 'bg-outline' %>"></span>
                      <span class="shrink-0 font-mono text-[10px] font-semibold text-on-surface-muted"><%= sidebar_project.key %></span>
                      <span class="truncate"><%= sidebar_project.name %></span>
                    <% end %>
                  <% end %>
                </nav>
                <p data-sidebar-target="projectEmpty" class="hidden px-2.5 pt-2 text-[11px] text-on-surface-muted">
                  Proyek tidak ditemukan.
                </p>
              <% else %>
                <p class="px-2.5 text-xs text-on-surface-muted">Belum ada proyek.</p>
              <% end %>
            </div>
          <% end %>
        </div>

        <% if authenticated? %>
          <div class="shrink-0 border-t border-outline-variant p-2.5">
            <%= link_to edit_profile_path,
              title: "Profil Saya & Pengaturan Tema",
              class: "group flex min-h-11 items-center justify-between gap-2 rounded-[8px] px-2 py-1.5 transition hover:bg-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary #{current_page?(edit_profile_path) ? 'bg-card border border-outline-variant/80' : ''}" do %>
              <div class="flex min-w-0 flex-1 items-center gap-2">
                <%= user_avatar(current_user, size_class: "w-8 h-8", text_class: "text-[11px]", lead: current_team_lead?) %>
                <div class="min-w-0 flex-1">
                  <p class="truncate text-xs font-semibold text-on-surface"><%= current_user.full_name %></p>
                  <p class="truncate text-[10px] text-on-surface-muted"><%= current_team_membership&.role_label || current_user.job_title %></p>
                </div>
              </div>
              <%= material_icon("settings", size: 17, extra_class: "text-on-surface-muted group-hover:text-on-surface") %>
            <% end %>
          </div>
        <% end %>
      </aside>

      <div class="flex min-w-0 flex-1 flex-col lg:pl-[220px]">
        <header class="sticky top-0 z-30 flex h-14 shrink-0 items-center justify-between gap-3 border-b border-outline-variant bg-canvas/90 px-4 backdrop-blur-xl sm:px-6">
          <div class="flex min-w-0 items-center gap-2.5">
            <button type="button"
                    data-action="sidebar#toggle"
                    aria-label="Buka menu navigasi"
                    class="inline-flex min-h-11 items-center gap-1.5 rounded-[8px] border border-outline-variant bg-panel px-2.5 py-1.5 text-xs font-semibold text-on-surface hover:bg-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary lg:hidden cursor-pointer shrink-0">
              <%= material_icon("menu", size: 18) %>
              <span>Menu</span>
            </button>

            <div class="flex min-w-0 items-center gap-2">
              <span class="hidden text-xs font-medium text-on-surface-muted sm:inline">SyncBoard</span>
              <span class="hidden text-xs text-outline sm:inline">/</span>
              <h1 class="truncate font-display text-sm font-semibold text-on-surface sm:text-[15px]"><%= content_for(:page_title) || "Workspace" %></h1>
            </div>
          </div>

          <div class="flex shrink-0 items-center gap-2">
            <% if authenticated? && current_team %>
              <%= link_to new_project_path, class: "hidden md:inline-flex min-h-8 items-center gap-1 rounded-[8px] border border-outline-variant bg-panel px-2.5 py-1 text-xs font-medium text-on-surface-variant hover:border-outline hover:bg-hover hover:text-on-surface focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary transition" do %>
                <%= material_icon("add", size: 15) %>
                <span>Proyek Baru</span>
              <% end %>
            <% end %>

            <% if authenticated? %>
              <%= button_to session_path,
                method: :delete,
                aria: { label: "Keluar dari SyncBoard" },
                class: "inline-flex min-h-11 sm:min-h-8 items-center gap-1 rounded-[8px] border border-outline-variant bg-panel px-2.5 py-1 text-xs font-medium text-on-surface-variant hover:border-danger-border hover:bg-danger-soft hover:text-on-danger-soft focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-danger transition cursor-pointer" do %>
                <%= material_icon("logout", size: 15) %>
                <span class="hidden sm:inline">Keluar</span>
              <% end %>
            <% end %>
          </div>
        </header>

        <main class="flex flex-1 flex-col min-w-0">
          <div id="flash_messages" class="<%= (flash[:notice].present? || flash[:alert].present?) ? 'px-4 pt-4 sm:px-6' : '' %>">
            <%= render "shared/flash_messages" %>
          </div>

          <% if content_for?(:full_bleed) %>
            <%= yield %>
          <% else %>
            <div class="mx-auto w-full max-w-6xl px-4 py-6 sm:px-6 lg:px-8">
              <%= yield %>
            </div>
          <% end %>
        </main>
      </div>
    </div>
  </body>
</html>
