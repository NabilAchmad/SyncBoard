<!DOCTYPE html>
<html lang="id">
  <head>
    <title><%= content_for(:title) || "SyncBoard — Team Workspace, Kanban & Meeting Room" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="SyncBoard">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-slate-100 text-slate-900 antialiased"
        data-controller="sidebar"
        data-user-role="<%= current_team ? (current_team_membership&.role || 'member') : 'guest' %>">
    <div class="flex min-h-screen">
      <!-- Backdrop mobile -->
      <div data-sidebar-target="backdrop"
           data-action="click->sidebar#close"
           class="fixed inset-0 z-40 hidden bg-slate-950/60 backdrop-blur-xs lg:hidden"></div>

      <!-- Sidebar SyncBoard (fixed agar tetap diam saat halaman di-scroll) -->
      <aside data-sidebar-target="panel"
             class="fixed inset-y-0 left-0 z-50 flex w-64 -translate-x-full flex-col bg-slate-900 text-slate-100 transition-transform duration-200 lg:translate-x-0 shrink-0">
        <div class="flex h-16 shrink-0 items-center justify-between border-b border-slate-800 px-5">
          <%= link_to root_path, class: "flex items-center gap-3" do %>
            <span class="inline-flex h-9 w-9 items-center justify-center rounded-xl bg-indigo-600 text-sm font-extrabold text-white shadow-sm">SB</span>
            <div class="leading-tight">
              <p class="text-sm font-bold text-white">SyncBoard</p>
              <p class="text-[11px] text-slate-400">Real-Time Team Workspace</p>
            </div>
          <% end %>

          <button type="button" data-action="sidebar#close" class="rounded-lg p-1 text-slate-400 hover:bg-slate-800 lg:hidden">
            ✕
          </button>
        </div>

        <div class="flex-1 overflow-y-auto px-3 py-5 space-y-6">
          <% if authenticated? %>
            <!-- Tim Aktif & Switcher -->
            <div class="px-1">
              <p class="px-2.5 mb-2 text-[11px] font-semibold uppercase tracking-wider text-slate-500">Tim Aktif</p>
              <% if current_team %>
                <div class="rounded-xl border border-slate-800 bg-slate-800/70 p-3 space-y-2">
                  <div class="flex items-start justify-between gap-2">
                    <p class="truncate text-xs font-bold text-white"><%= current_team.name %></p>
                    <span class="shrink-0 rounded px-1.5 py-0.5 text-[10px] font-semibold <%= current_team_lead? ? 'bg-indigo-500/20 text-indigo-300' : 'bg-slate-700 text-slate-300' %>">
                      <%= current_team_lead? ? "Lead" : "Member" %>
                    </span>
                  </div>

                  <% if current_team_lead? %>
                    <div class="flex items-center justify-between gap-2 rounded-lg bg-slate-900/80 px-2.5 py-1.5">
                      <span class="font-mono text-xs font-bold tracking-widest text-indigo-300"><%= current_team.invite_code %></span>
                      <button type="button"
                              data-action="sidebar#copyCode"
                              data-code="<%= current_team.invite_code %>"
                              class="text-[10px] font-semibold text-slate-300 hover:text-white cursor-pointer">
                        Salin
                      </button>
                    </div>
                  <% end %>

                  <% if available_teams.size > 1 %>
                    <details class="pt-1 text-xs">
                      <summary class="cursor-pointer font-medium text-slate-300 hover:text-white">
                        Ganti Tim (<%= available_teams.size %>)
                      </summary>
                      <div class="mt-2 space-y-1">
                        <% available_teams.each do |team| %>
                          <% next if team.id == current_team.id %>
                          <%= button_to team.name, switch_team_path(team),
                            method: :post,
                            class: "w-full truncate rounded-lg bg-slate-900/70 px-2.5 py-1.5 text-left text-[11px] font-medium text-slate-300 hover:bg-indigo-600 hover:text-white transition cursor-pointer" %>
                        <% end %>
                      </div>
                    </details>
                  <% end %>

                  <%= link_to "Gabung / Buat Tim →", teams_path, class: "block pt-0.5 text-[11px] font-medium text-indigo-300 hover:text-indigo-200" %>
                </div>
              <% else %>
                <div class="rounded-xl border border-dashed border-slate-700 bg-slate-900/60 p-3 space-y-1.5">
                  <p class="text-xs font-semibold text-slate-200">Belum Ada Tim</p>
                  <p class="text-[11px] text-slate-400">Masukkan kode undangan 6 karakter untuk bergabung.</p>
                </div>
              <% end %>
            </div>
          <% end %>

          <div>
            <p class="px-3.5 mb-2 text-[11px] font-semibold uppercase tracking-wider text-slate-500">Workspace</p>
            <nav class="space-y-1">
              <%= link_to root_path, class: sidebar_link_class(root_path) do %>
                <span>📋</span>
                <span>Semua Proyek & Board</span>
              <% end %>

              <% if current_team %>
                <%= link_to new_project_path, class: sidebar_link_class(new_project_path) do %>
                  <span>✨</span>
                  <span>Buat Proyek Baru</span>
                <% end %>
              <% end %>

              <%= link_to teams_path, class: sidebar_link_class(teams_path) do %>
                <span>🔑</span>
                <span>Tim & Undangan</span>
              <% end %>

              <%= link_to edit_profile_path, class: sidebar_link_class(edit_profile_path) do %>
                <span>👤</span>
                <span>Profil Saya</span>
              <% end %>

              <% if current_team && current_team_lead? %>
                <%= link_to team_members_path, class: sidebar_link_class(team_members_path) do %>
                  <span>👥</span>
                  <span>Kelola Anggota Tim</span>
                <% end %>
              <% end %>
            </nav>
          </div>

          <% if authenticated? && current_team %>
            <div>
              <p class="px-3.5 mb-2 text-[11px] font-semibold uppercase tracking-wider text-slate-500">Proyek Aktif</p>
              <% active_projects = current_team.projects.active.ordered.limit(6) %>
              <% if active_projects.any? %>
                <nav class="space-y-1">
                  <% active_projects.each do |sidebar_project| %>
                    <%= link_to project_path(sidebar_project), class: sidebar_link_class(project_path(sidebar_project)) do %>
                      <span class="inline-flex h-5 w-8 shrink-0 items-center justify-center rounded bg-slate-800 text-[10px] font-bold text-indigo-300"><%= sidebar_project.key %></span>
                      <span class="truncate"><%= sidebar_project.name %></span>
                    <% end %>
                  <% end %>
                </nav>
              <% else %>
                <p class="px-3.5 text-xs text-slate-500">Belum ada proyek.</p>
              <% end %>
            </div>
          <% end %>
        </div>

        <% if authenticated? %>
          <div class="shrink-0 border-t border-slate-800 p-4">
            <div class="flex items-center gap-3">
              <%= user_avatar(current_user, size_class: "w-10 h-10", text_class: "text-xs", lead: current_team_lead?) %>
              <div class="min-w-0 flex-1">
                <p class="truncate text-sm font-semibold text-white"><%= current_user.full_name %></p>
                <p class="truncate text-xs text-slate-400"><%= current_user.employee_code %> · <%= current_user.job_title %></p>
              </div>
            </div>

            <div class="mt-3 flex items-center justify-between gap-2">
              <span class="inline-flex items-center rounded-md px-2 py-0.5 text-[11px] font-semibold <%= current_team_lead? ? 'bg-indigo-500/20 text-indigo-300' : 'bg-slate-800 text-slate-300' %>">
                <%= current_team_membership&.role_label || "Belum Masuk Tim" %>
              </span>

              <%= button_to "Keluar", session_path,
                method: :delete,
                class: "rounded-lg bg-slate-800 px-3 py-1.5 text-xs font-medium text-slate-200 hover:bg-rose-600 hover:text-white transition cursor-pointer" %>
            </div>
          </div>
        <% end %>
      </aside>

      <!-- Konten Utama -->
      <div class="flex min-w-0 flex-1 flex-col lg:pl-64">
        <header class="sticky top-0 z-30 flex h-16 items-center justify-between border-b border-slate-200 bg-white/95 px-4 backdrop-blur-xs sm:px-6 lg:px-8">
          <div class="flex items-center gap-3 min-w-0">
            <button type="button"
                    data-action="sidebar#toggle"
                    class="rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 text-sm font-semibold text-slate-700 hover:bg-slate-50 lg:hidden">
              ☰
            </button>
            <h1 class="truncate text-base font-bold text-slate-900 sm:text-lg"><%= content_for(:page_title) || "SyncBoard Workspace" %></h1>
          </div>

          <div class="flex items-center gap-2.5 text-xs text-slate-500 shrink-0">
            <span class="hidden sm:inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-3 py-1 font-semibold text-emerald-700 ring-1 ring-inset ring-emerald-600/20">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
              ActionCable Live
            </span>
            <span class="rounded-full bg-indigo-50 px-3 py-1 font-semibold text-indigo-700">
              <%= Date.current.strftime("%d %b %Y") %>
            </span>
          </div>
        </header>

        <main class="flex-1 px-4 py-6 sm:px-6 lg:px-8">
          <div class="mx-auto max-w-7xl">
            <div id="flash_messages">
              <%= render "shared/flash_messages" %>
            </div>

            <%= yield %>
          </div>
        </main>
      </div>
    </div>
  </body>
</html>
