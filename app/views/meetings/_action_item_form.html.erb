<% id_prefix = item.persisted? ? "edit_item_#{item.id}" : "new_action_item" %>
<% initial_mode = item.persisted? && item.updates_existing_task? ? "existing" : "create" %>
<% existing_action_options = MeetingActionItem::EXISTING_ACTION_TYPES.map { |type| [MeetingActionItem::ACTION_TYPES[type], type] } %>
<% existing_selected_action = item.updates_existing_task? ? item.action_type : "update_task" %>

<%= form_with model: item,
  url: url,
  method: method,
  namespace: id_prefix,
  class: "mt-3 space-y-3",
  data: {
    controller: "summary-item-form",
    "summary-item-form-mode-value": initial_mode
  } do |form| %>
  <fieldset>
    <legend class="mb-1.5 text-[11px] font-semibold text-on-surface-variant">Jenis Aksi Kanban</legend>
    <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
      <label class="flex min-h-11 sm:min-h-0 cursor-pointer items-center gap-2 rounded-xl border border-outline bg-card px-3 py-2 text-xs font-medium text-on-surface hover:border-primary focus-within:ring-2 focus-within:ring-primary">
        <%= radio_button_tag :item_mode, "create", initial_mode == "create",
          id: "#{id_prefix}_mode_create",
          data: { action: "change->summary-item-form#switchMode" },
          class: "h-4 w-4 accent-primary focus:ring-primary" %>
        <span>Buat Ticket Baru</span>
      </label>

      <label class="flex min-h-11 sm:min-h-0 cursor-pointer items-center gap-2 rounded-xl border border-outline bg-card px-3 py-2 text-xs font-medium text-on-surface hover:border-primary focus-within:ring-2 focus-within:ring-primary">
        <%= radio_button_tag :item_mode, "existing", initial_mode == "existing",
          id: "#{id_prefix}_mode_existing",
          data: { action: "change->summary-item-form#switchMode" },
          class: "h-4 w-4 accent-primary focus:ring-primary" %>
        <span>Update Ticket yang Sudah Ada</span>
      </label>
    </div>
  </fieldset>

  <div data-summary-item-form-target="existingGroup" class="grid grid-cols-1 gap-2 sm:grid-cols-2 <%= 'hidden' unless initial_mode == 'existing' %>">
    <div class="min-w-0">
      <%= form.label :action_type, "Tipe Update", class: ui_label_class("mb-1 text-[11px]") %>
      <%= form.select :action_type,
        options_for_select(existing_action_options, existing_selected_action),
        {},
        disabled: initial_mode != "existing",
        data: { "summary-item-form-target": "existingActionSelect" },
        class: ui_input_class("px-2.5 py-1.5 text-xs") %>
    </div>

    <div class="min-w-0">
      <%= form.label :target_task_id, "Pilih Ticket Target", class: ui_label_class("mb-1 text-[11px]") %>
      <%= form.select :target_task_id,
        options_from_collection_for_select(project_tasks, :id, ->(t) { "#{t.code}: #{t.title.truncate(32)}" }, item.target_task_id),
        { include_blank: "Pilih ticket di board..." },
        disabled: initial_mode != "existing",
        required: initial_mode == "existing",
        data: { "summary-item-form-target": "targetTaskSelect" },
        class: ui_input_class("px-2.5 py-1.5 text-xs") %>
    </div>
  </div>

  <div class="min-w-0">
    <%= form.label :title, "Judul Ticket / Catatan Update", class: ui_label_class("mb-1 text-[11px]") %>
    <%= form.text_field :title,
      required: initial_mode == "create",
      placeholder: initial_mode == "existing" ? "Catatan update (opsional, kosongkan untuk pakai judul ticket asli)..." : "Judul ticket / task baru...",
      data: { "summary-item-form-target": "titleInput" },
      class: ui_input_class("px-2.5 py-1.5 text-xs") %>
  </div>

  <div class="grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-4">
    <div class="min-w-0">
      <%= form.label :target_column, "Kolom Target", class: ui_label_class("mb-1 text-[11px]") %>
      <%= form.select :target_column,
        options_for_select(Task::COLUMNS.map { |k, v| [v, k] }, item.target_column.presence || "todo"),
        {},
        class: ui_input_class("px-2.5 py-1.5 text-xs") %>
    </div>

    <div class="min-w-0">
      <%= form.label :priority, "Prioritas", class: ui_label_class("mb-1 text-[11px]") %>
      <%= form.select :priority,
        options_for_select(Task::PRIORITIES.map { |k, v| [v, k] }, item.priority.presence || "medium"),
        {},
        class: ui_input_class("px-2.5 py-1.5 text-xs") %>
    </div>

    <div class="min-w-0">
      <%= form.label :assignee_id, "PIC", class: ui_label_class("mb-1 text-[11px]") %>
      <%= form.select :assignee_id,
        options_from_collection_for_select(team_members, :id, :full_name, item.assignee_id),
        { include_blank: "Pilih PIC..." },
        class: ui_input_class("px-2.5 py-1.5 text-xs") %>
    </div>

    <div class="min-w-0">
      <%= form.label :due_date, "Target Penyelesaian", class: ui_label_class("mb-1 text-[11px]") %>
      <%= form.date_field :due_date, class: ui_input_class("px-2.5 py-1.5 text-xs") %>
    </div>
  </div>

  <div>
    <%= form.submit submit_label, class: ui_btn_secondary_class %>
  </div>
<% end %>
