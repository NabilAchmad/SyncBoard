<% content_for :title, "#{@meeting.title} (#{@meeting.room_code}) | SyncBoard" %>
<% content_for :page_title, "#{@project.key} · #{@meeting.title}" %>
<% content_for :full_bleed, "true" %>
<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>

<%= turbo_stream_from @meeting, :room %>

<% first_code = @project_tasks[0]&.code || "#{@project.key}-1" %>
<% is_room_host = (@meeting.host_id == current_user.id) %>
<% has_pending_acc = @meeting.pending_approval? %>

<div class="flex flex-1 flex-col min-h-0"
     data-controller="meeting-room"
     data-action="keydown.window->meeting-room#handleKeydown"
     data-meeting-room-meeting-id-value="<%= @meeting.id %>"
     data-meeting-room-user-id-value="<%= current_user.id %>"
     data-meeting-room-user-name-value="<%= current_user.full_name %>"
     data-meeting-room-user-initials-value="<%= current_user.initials %>"
     data-meeting-room-user-role-value="<%= current_user.role_label %>"
     data-meeting-room-save-transcript-url-value="<%= save_transcript_project_meeting_path(@project, @meeting) %>"
     data-meeting-room-is-host-value="<%= is_room_host %>"
     data-meeting-room-ice-servers-value="<%= webrtc_ice_servers.to_json %>"
     data-meeting-room-auto-join-call-value="<%= @meeting.ended_at.blank? && !@meeting.approved? && !@meeting.ended? %>">

  <div class="flex flex-wrap items-center justify-between gap-2.5 border-b border-outline-variant bg-panel px-4 py-2.5 sm:px-6 shrink-0">
    <div class="flex flex-wrap items-center gap-2 min-w-0">
      <span class="h-2 w-2 shrink-0 rounded-full <%= @meeting.live? ? 'bg-danger animate-pulse' : 'bg-outline' %>" aria-hidden="true"></span>
      <h2 class="truncate font-display text-sm sm:text-base font-semibold text-on-surface"><%= @meeting.title %></h2>
      <span class="rounded-[6px] border border-outline-variant bg-inset px-2 py-0.5 font-mono text-[11px] font-semibold text-on-surface"><%= @meeting.room_code %></span>
      <%= meeting_status_badge(@meeting) %>
      <span data-meeting-room-target="participantCount" class="rounded-[6px] border border-primary-border bg-primary-soft px-2 py-0.5 font-mono text-[11px] font-semibold text-on-primary-soft">
        1 Online
      </span>
      <span data-meeting-room-target="localStatus" class="inline-flex max-w-full items-center rounded-[6px] border border-outline-variant bg-inset px-2 py-0.5 text-[11px] text-on-surface-muted">
        Menghubungkan...
      </span>
    </div>

    <%= link_to project_path(@project), class: "inline-flex min-h-11 sm:min-h-8 items-center gap-1 rounded-[8px] border border-outline-variant bg-card px-2.5 py-1 text-xs font-semibold text-on-surface hover:border-outline hover:bg-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary transition shrink-0" do %>
      <%= material_icon("arrow_back", size: 15) %>
      <span>Kembali ke Kanban</span>
    <% end %>
  </div>

  <div class="flex flex-1 flex-col lg:grid lg:grid-cols-12 min-h-0">
    <div class="flex flex-col justify-between gap-3 p-3 sm:p-4 lg:col-span-8 min-w-0 min-h-0">
      <div class="grid flex-1 grid-cols-1 gap-3 sm:grid-cols-2 items-stretch min-h-[240px]">
        <div class="relative aspect-video lg:aspect-auto lg:min-h-[220px] overflow-hidden rounded-[12px] border border-outline-variant bg-column shadow-2xs">
          <video data-meeting-room-target="localVideo" autoplay muted playsinline class="hidden h-full w-full object-cover"></video>
          <div data-meeting-room-target="localPlaceholder" class="flex h-full w-full flex-col items-center justify-center bg-inset p-4 pb-10 text-center">
            <div class="flex h-12 w-12 items-center justify-center rounded-xl border border-outline bg-card font-display text-base font-semibold text-on-surface"><%= current_user.initials %></div>
            <p class="mt-2 text-xs font-semibold text-on-surface"><%= current_user.full_name %></p>
            <p class="text-[11px] text-on-surface-muted"><%= current_user.role_label %></p>
          </div>
          <div class="absolute left-2.5 bottom-2.5 inline-flex max-w-[calc(100%-1.25rem)] items-center gap-1.5 rounded-full bg-inverse-surface/85 px-2.5 py-1 text-[11px] font-medium text-inverse-on-surface backdrop-blur-xs">
            <span class="truncate">Anda · <%= current_user.full_name %></span>
          </div>
        </div>

        <div data-meeting-room-target="peersGrid" class="contents"></div>

        <div data-meeting-room-target="emptyState" class="flex aspect-video lg:aspect-auto lg:min-h-[220px] flex-col items-center justify-center rounded-[12px] border border-dashed border-outline-variant bg-inset/60 p-4 text-center">
          <%= material_icon("group_add", size: 22, extra_class: "text-on-surface-muted mb-1.5") %>
          <p class="font-display text-sm font-semibold text-on-surface">Menunggu peserta lain</p>
          <p class="mt-0.5 text-[11px] text-on-surface-muted">
            Kode room <span class="font-mono font-semibold text-on-surface"><%= @meeting.room_code %></span>
          </p>
        </div>
      </div>

      <div class="space-y-2 shrink-0">
        <div class="grid gap-2 sm:grid-cols-12 items-center">
          <div data-meeting-room-target="liveCaptions" class="sm:col-span-7 truncate rounded-[10px] border border-outline-variant bg-panel px-3 py-2 text-xs text-on-surface-variant">
            Live captions siap digunakan.
          </div>

          <form data-action="submit->meeting-room#submitQuickCaption" class="flex items-center gap-1.5 sm:col-span-5">
            <input type="text"
                   data-meeting-room-target="quickCaptionInput"
                   aria-label="Quick caption"
                   placeholder="Ketik poin cepat..."
                   class="min-h-11 sm:min-h-8 min-w-0 flex-1 rounded-[10px] border border-outline-variant bg-input px-3 py-1.5 text-xs text-on-surface placeholder:text-on-surface-muted focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/25">
            <button type="submit"
                    aria-label="Kirim Caption"
                    class="inline-flex min-h-11 sm:min-h-8 items-center justify-center rounded-[10px] border border-outline-variant bg-panel px-3 py-1.5 text-xs font-semibold text-on-surface hover:bg-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary cursor-pointer shrink-0">
              Kirim
            </button>
          </form>
        </div>

        <div class="flex justify-center pt-1">
          <div class="inline-flex flex-wrap items-center justify-center gap-1.5 rounded-full border border-outline-variant/25 bg-inverse-surface p-1.5 text-inverse-on-surface shadow-lg">
            <button type="button"
                    data-meeting-room-target="micButton"
                    data-action="meeting-room#toggleMic"
                    title="Mic"
                    aria-label="Mic"
                    class="inline-flex h-11 w-11 sm:h-9 sm:w-9 items-center justify-center rounded-full bg-white/15 text-inverse-on-surface hover:bg-white/25 transition cursor-pointer">
              <span data-role="icon" data-icon-size="18" class="inline-flex shrink-0 items-center justify-center leading-none" aria-hidden="true"><%= material_icon("mic", size: 18) %></span>
              <span data-role="label" class="sr-only">Mic</span>
            </button>

            <button type="button"
                    data-meeting-room-target="camButton"
                    data-action="meeting-room#toggleCam"
                    title="Kamera"
                    aria-label="Kamera"
                    class="inline-flex h-11 w-11 sm:h-9 sm:w-9 items-center justify-center rounded-full bg-white/15 text-inverse-on-surface hover:bg-white/25 transition cursor-pointer">
              <span data-role="icon" data-icon-size="18" class="inline-flex shrink-0 items-center justify-center leading-none" aria-hidden="true"><%= material_icon("videocam", size: 18) %></span>
              <span data-role="label" class="sr-only">Cam</span>
            </button>

            <button type="button"
                    data-meeting-room-target="mirrorButton"
                    data-action="meeting-room#toggleMirror"
                    title="Flip Kamera"
                    aria-label="Flip Kamera"
                    class="inline-flex h-11 w-11 sm:h-9 sm:w-9 items-center justify-center rounded-full bg-white/15 text-inverse-on-surface hover:bg-white/25 transition cursor-pointer">
              <span data-role="icon" data-icon-size="18" class="inline-flex shrink-0 items-center justify-center leading-none" aria-hidden="true"><%= material_icon("flip", size: 18) %></span>
              <span data-role="label" class="sr-only">Flip Cam</span>
            </button>

            <button type="button"
                    data-meeting-room-target="screenButton"
                    data-action="meeting-room#toggleScreenShare"
                    title="Share Screen"
                    aria-label="Share Screen"
                    class="inline-flex h-11 w-11 sm:h-9 sm:w-9 items-center justify-center rounded-full bg-white/15 text-inverse-on-surface hover:bg-white/25 transition cursor-pointer">
              <span data-role="icon" data-icon-size="18" class="inline-flex shrink-0 items-center justify-center leading-none" aria-hidden="true"><%= material_icon("present_to_all", size: 18) %></span>
              <span data-role="label" class="sr-only">Share Screen</span>
            </button>

            <button type="button"
                    data-meeting-room-target="speechButton"
                    data-action="meeting-room#toggleSpeechRecognition"
                    title="Live Speech-to-Text"
                    aria-label="Live Speech-to-Text"
                    class="inline-flex h-11 w-11 sm:h-9 sm:w-9 items-center justify-center rounded-full bg-white/15 text-inverse-on-surface hover:bg-white/25 transition cursor-pointer">
              <span data-role="icon" data-icon-size="18" class="inline-flex shrink-0 items-center justify-center leading-none" aria-hidden="true"><%= material_icon("closed_caption", size: 18) %></span>
              <span data-role="label" class="sr-only">Live Speech-to-Text</span>
            </button>

            <span class="hidden sm:inline-block h-5 w-px bg-white/20 mx-0.5" aria-hidden="true"></span>

            <button type="button"
                    data-meeting-room-target="callButton"
                    data-action="meeting-room#toggleCall"
                    class="inline-flex h-11 sm:h-9 items-center justify-center gap-1.5 rounded-full bg-danger px-3.5 text-xs font-semibold text-on-danger hover:bg-danger-hover transition cursor-pointer">
              <span data-role="icon" data-icon-size="16" class="inline-flex shrink-0 items-center justify-center leading-none" aria-hidden="true"><%= material_icon("call_end", size: 16) %></span>
              <span data-role="label"><%= is_room_host ? "Akhiri Panggilan" : "Keluar dari Panggilan" %></span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <aside class="flex flex-col border-t border-outline-variant bg-panel lg:col-span-4 lg:border-l lg:border-t-0 min-h-[480px] lg:min-h-0">
      <div role="tablist" aria-label="Panel Meeting" class="grid grid-cols-3 border-b border-outline-variant bg-sidebar/60 shrink-0">
        <button type="button"
                role="tab"
                data-meeting-room-target="rightTab"
                data-meeting-tab="summary"
                data-action="meeting-room#switchRightTab"
                aria-selected="true"
                class="inline-flex min-h-11 sm:min-h-9 items-center justify-center gap-1.5 border-b-2 border-primary bg-panel px-2 py-1.5 text-xs font-semibold text-primary-text transition cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary">
          Ringkasan
        </button>

        <button type="button"
                role="tab"
                data-meeting-room-target="rightTab"
                data-meeting-tab="chat"
                data-action="meeting-room#switchRightTab"
                aria-selected="false"
                class="inline-flex min-h-11 sm:min-h-9 items-center justify-center gap-1.5 border-b-2 border-transparent px-2 py-1.5 text-xs font-semibold text-on-surface-muted hover:text-on-surface hover:bg-hover/60 transition cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary">
          Chat Live
        </button>

        <button type="button"
                role="tab"
                data-meeting-room-target="rightTab"
                data-meeting-tab="transcript"
                data-action="meeting-room#switchRightTab"
                aria-selected="false"
                class="inline-flex min-h-11 sm:min-h-9 items-center justify-center gap-1.5 border-b-2 border-transparent px-2 py-1.5 text-xs font-semibold text-on-surface-muted hover:text-on-surface hover:bg-hover/60 transition cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary">
          Transcript
        </button>
      </div>

      <div data-meeting-room-target="rightPanel"
           data-meeting-panel="summary"
           class="flex-1 overflow-y-auto p-4 min-h-0">
        <%= render "meetings/summary_panel",
          meeting: @meeting,
          project: @project,
          team_members: @team_members,
          project_tasks: @project_tasks %>
      </div>

      <div data-meeting-room-target="rightPanel"
           data-meeting-panel="chat"
           class="hidden flex-1 flex-col min-h-0">
        <div id="<%= dom_id(@meeting, :messages) %>" class="flex-1 space-y-2.5 overflow-y-auto p-4">
          <% @messages.each do |message| %>
            <%= render "meeting_messages/message", message: message %>
          <% end %>
        </div>

        <%= form_with model: [@project, @meeting, @new_message],
          data: {
            meeting_room_target: "messageForm",
            action: "turbo:submit-end->meeting-room#resetMessageForm"
          },
          class: "border-t border-outline-variant p-3 space-y-2 shrink-0 bg-panel" do |form| %>
          <div class="flex flex-wrap sm:flex-nowrap items-center gap-1.5">
            <%= form.select :kind,
              [ ["Chat", "chat"], ["Keputusan", "decision"], ["Catatan", "note"] ],
              {},
              aria: { label: "Tipe pesan" },
              class: "min-h-11 sm:min-h-9 rounded-[10px] border border-outline-variant bg-input px-2 py-1.5 text-xs font-medium text-on-surface focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/25" %>
            <%= form.text_field :body,
              required: true,
              data: { meeting_room_target: "messageBody" },
              placeholder: "Tulis pesan atau keputusan...",
              class: "min-h-11 sm:min-h-9 min-w-0 flex-1 rounded-[10px] border border-outline-variant bg-input px-3 py-1.5 text-xs text-on-surface placeholder:text-on-surface-muted focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/25" %>
            <%= form.submit "Kirim", class: ui_btn_secondary_class("min-h-11 sm:min-h-9 px-3 py-1.5 text-xs rounded-[10px] shrink-0") %>
          </div>
        <% end %>
      </div>

      <div data-meeting-room-target="rightPanel"
           data-meeting-panel="transcript"
           class="hidden flex-1 flex-col p-4 gap-3 min-h-0">
        <div class="flex items-center justify-between gap-2 shrink-0">
          <span class="text-xs font-semibold text-on-surface">Notulensi &amp; Transcript</span>
          <span data-meeting-room-target="saveStatus" class="font-mono text-[10px] text-on-surface-muted"></span>
        </div>

        <%= form_with url: generate_summary_project_meeting_path(@project, @meeting), method: :post, class: "flex flex-1 flex-col gap-3 min-h-0" do %>
          <%= text_area_tag :transcript_text, @meeting.transcript_text,
            rows: 10,
            data: {
              meeting_room_target: "transcriptInput",
              action: "input->meeting-room#scheduleSaveTranscript"
            },
            placeholder: "Catat poin diskusi atau gunakan Live Speech-to-Text.\nContoh: #{first_code} sudah selesai (done), PIC Budi.",
            class: "flex-1 min-h-[220px] w-full rounded-[10px] border border-outline-variant bg-input p-3 font-mono text-xs leading-relaxed text-on-surface placeholder:text-on-surface-muted focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/25" %>

          <%= submit_tag "Generate Rangkuman & Usulan Kanban", class: (has_pending_acc ? ui_btn_secondary_class("w-full py-2.5 text-xs rounded-[10px]") : ui_btn_primary_class("w-full py-2.5 text-xs rounded-[10px]")) %>
        <% end %>
      </div>
    </aside>
  </div>

  <% if is_room_host %>
    <div data-meeting-room-target="endCallModal"
         role="dialog"
         aria-modal="true"
         aria-labelledby="end_call_modal_title"
         class="fixed inset-0 z-50 hidden overflow-y-auto bg-inverse-surface/60 p-4 backdrop-blur-[1px]">
      <div class="flex min-h-full items-center justify-center">
        <div class="w-full max-w-sm space-y-4 rounded-[12px] border border-outline-variant bg-panel p-6 shadow-sm">
          <div class="space-y-1.5">
            <h3 id="end_call_modal_title" class="font-display text-lg font-semibold text-on-surface">Akhiri Panggilan Rapat?</h3>
            <p class="text-xs leading-relaxed text-on-surface-variant">
              Tutup panggilan untuk semua peserta atau keluar sendiri agar tim tetap melanjutkan diskusi.
            </p>
          </div>

          <div class="space-y-2.5 pt-1">
            <%= button_to "Akhiri untuk Semua", end_call_project_meeting_path(@project, @meeting),
              method: :post,
              data: { action: "meeting-room#endMeetingSession" },
              class: "inline-flex min-h-11 w-full items-center justify-center rounded-[10px] bg-danger px-4 py-2.5 text-xs font-semibold text-on-danger hover:bg-danger-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-danger transition cursor-pointer" %>

            <button type="button"
                    data-action="meeting-room#leaveCallAndCloseModal"
                    class="<%= ui_btn_secondary_class('w-full py-2.5 rounded-[10px]') %>">
              Keluar dari Panggilan
            </button>

            <button type="button"
                    data-action="meeting-room#closeEndCallModal"
                    class="inline-flex min-h-11 w-full items-center justify-center rounded-[10px] px-4 py-2 text-xs font-semibold text-on-surface-variant hover:bg-hover hover:text-on-surface focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary transition cursor-pointer">
              Batal
            </button>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
