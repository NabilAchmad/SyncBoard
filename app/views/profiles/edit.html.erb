<% content_for :title, "Profil Saya | SyncBoard" %>
<% content_for :page_title, "Profil & Pengaturan Tema" %>

<div class="mx-auto max-w-3xl space-y-6">
  <div class="rounded-[12px] border border-outline-variant bg-panel p-6 sm:p-7 shadow-2xs">
    <%= form_with model: @user, url: profile_path, method: :patch, class: "space-y-5" do |form| %>
      <%= render "shared/form_errors", record: @user %>

      <div class="flex flex-col gap-4 border-b border-outline-variant pb-5 sm:flex-row sm:items-center">
        <%= user_avatar(@user, size_class: "w-14 h-14", text_class: "text-lg", lead: current_team_lead?) %>
        <div class="flex-1 space-y-2">
          <div class="flex flex-wrap items-center gap-2">
            <span class="rounded-md border border-outline-variant bg-inset px-2 py-0.5 font-mono text-[11px] font-semibold text-on-surface"><%= @user.employee_code %></span>
            <span class="rounded-md border border-outline-variant bg-inset px-2 py-0.5 text-[11px] font-semibold text-on-surface-variant"><%= @user.role_label %></span>
          </div>
          <%= form.label :avatar, "Foto Profil (PNG/JPG/WebP · Maks 2 MB)", class: ui_label_class("text-xs") %>
          <%= form.file_field :avatar,
            accept: "image/png,image/jpeg,image/webp,image/gif",
            class: "block w-full cursor-pointer text-xs text-on-surface-variant file:mr-3 file:min-h-11 sm:file:min-h-9 file:cursor-pointer file:rounded-[10px] file:border file:border-outline-variant file:bg-card file:px-3 file:py-1.5 file:text-xs file:font-semibold file:text-on-surface hover:file:bg-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary" %>

          <% if @user.avatar.attached? %>
            <label class="inline-flex min-h-11 cursor-pointer items-center gap-2 text-xs font-medium text-on-danger-soft">
              <%= check_box_tag :remove_avatar, "1", false, class: "h-4 w-4 rounded border-outline bg-input accent-danger focus:ring-danger" %>
              <span>Hapus foto profil saat ini</span>
            </label>
          <% end %>
        </div>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <%= form.label :full_name, "Nama Lengkap", class: ui_label_class("text-xs") %>
          <%= form.text_field :full_name, required: true, class: ui_input_class("mt-1.5 rounded-[12px]") %>
        </div>

        <div>
          <%= form.label :phone, "Nomor Telepon / WhatsApp", class: ui_label_class("text-xs") %>
          <%= form.text_field :phone, placeholder: "0812-xxxx-xxxx", class: ui_input_class("mt-1.5 rounded-[12px]") %>
        </div>

        <div>
          <%= form.label :department, "Divisi", class: ui_label_class("text-xs") %>
          <%= form.select :department, User::DEPARTMENTS, {}, class: ui_input_class("mt-1.5 rounded-[12px]") %>
        </div>

        <div>
          <%= form.label :job_title, "Jabatan", class: ui_label_class("text-xs") %>
          <%= form.text_field :job_title, required: true, class: ui_input_class("mt-1.5 rounded-[12px]") %>
        </div>
      </div>

      <div class="flex flex-wrap items-center justify-end gap-3 border-t border-outline-variant pt-4">
        <%= link_to "Kembali ke Workspace", root_path, class: ui_btn_secondary_class("px-4 py-2 text-xs rounded-[10px]") %>
        <%= form.submit "Simpan Perubahan", class: ui_btn_primary_class("px-5 py-2 text-xs rounded-[10px]") %>
      </div>
    <% end %>
  </div>

  <div class="rounded-[12px] border border-outline-variant bg-panel p-6 sm:p-7 shadow-2xs space-y-4">
    <div>
      <h2 class="font-display text-base font-semibold text-on-surface">Preferensi Tampilan</h2>
      <p class="mt-0.5 text-xs text-on-surface-variant">Pilih tampilan terang, gelap, atau ikuti preferensi sistem perangkat Anda.</p>
    </div>

    <%= render "shared/theme_setting", variant: :segmented %>
  </div>
</div>
