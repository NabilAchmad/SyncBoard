<% content_for :title, "Tim & Kode Undangan | SyncBoard" %>
<% content_for :page_title, "Tim & Kode Undangan" %>

<div class="space-y-6">
  <div class="<%= ui_card_class('p-6 space-y-4') %>">
    <div>
      <h2 class="font-display text-xl font-semibold text-on-surface">Tim Anda (<span class="font-mono"><%= @memberships.size %></span>)</h2>
      <p class="mt-1 text-xs text-on-surface-variant">Pilih tim aktif, salin kode undangan 6 karakter, atau kelola keanggotaan Anda.</p>
    </div>

    <% if @memberships.any? %>
      <div class="grid gap-4 md:grid-cols-2">
        <% @memberships.each do |membership| %>
          <% team = membership.team %>
          <% is_active = current_team&.id == team.id %>
          <div class="flex flex-col justify-between space-y-4 rounded-xl border <%= is_active ? 'border-primary-border bg-card shadow-xs' : 'border-outline-variant bg-inset' %> p-5 transition">
            <div class="space-y-3">
              <div class="flex items-start justify-between gap-2">
                <div class="min-w-0">
                  <div class="flex flex-wrap items-center gap-2">
                    <h3 class="truncate font-display text-base font-semibold text-on-surface"><%= team.name %></h3>
                    <% if is_active %>
                      <span class="rounded-md border border-primary-border bg-primary-soft px-2 py-0.5 text-[11px] font-semibold text-on-primary-soft">Aktif</span>
                    <% end %>
                  </div>
                  <p class="mt-1 text-xs text-on-surface-variant"><%= team.description.presence || "Workspace kolaborasi tim" %></p>
                </div>
                <span class="shrink-0 rounded-md border border-outline-variant bg-card px-2 py-0.5 text-[11px] font-semibold text-on-surface-variant">
                  <%= membership.role_label %>
                </span>
              </div>

              <div class="flex flex-wrap items-center gap-3 font-mono text-xs text-on-surface-muted">
                <span><%= @member_counts_by_team ? @member_counts_by_team.fetch(team.id, 0) : team.team_memberships.size %> anggota</span>
                <span aria-hidden="true">·</span>
                <span><%= @project_counts_by_team ? @project_counts_by_team.fetch(team.id, 0) : team.projects.size %> proyek</span>
              </div>

              <% if membership.lead? %>
                <div class="flex flex-wrap items-center justify-between gap-2 rounded-xl border border-outline-variant bg-inset px-3.5 py-2.5">
                  <div>
                    <p class="text-[11px] font-semibold uppercase tracking-wider text-on-surface-muted">Kode Undangan</p>
                    <p class="font-mono text-sm font-semibold tracking-widest text-on-surface"><%= team.invite_code %></p>
                  </div>
                  <button type="button"
                          data-action="sidebar#copyCode"
                          data-code="<%= team.invite_code %>"
                          class="<%= ui_btn_secondary_class('px-3 py-1.5 text-[11px]') %>">
                    Salin Kode
                  </button>
                </div>
              <% end %>
            </div>

            <div class="flex flex-wrap items-center justify-between gap-2 border-t border-outline-variant pt-3.5">
              <% if is_active %>
                <%= link_to "Buka Workspace", root_path, class: ui_btn_secondary_class %>
              <% else %>
                <%= button_to "Masuk Tim Ini", switch_team_path(team),
                  method: :post,
                  class: ui_btn_primary_class("px-3.5 py-2 text-xs") %>
              <% end %>

              <%= button_to "Keluar Tim", leave_team_path(team),
                method: :delete,
                class: ui_btn_danger_class %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="rounded-xl border border-dashed border-outline bg-inset p-6 text-center text-xs text-on-surface-variant">
        Anda belum tergabung di tim mana pun. Gunakan form di bawah untuk memasukkan kode undangan atau membuat tim baru.
      </div>
    <% end %>
  </div>

  <div class="grid gap-6 md:grid-cols-2">
    <div class="<%= ui_card_class('p-6 space-y-4') %>">
      <div>
        <h3 class="font-display text-lg font-semibold text-on-surface">Gabung Tim dengan Kode Undangan</h3>
        <p class="mt-1 text-xs text-on-surface-variant">Masukkan kode 6 karakter gabungan huruf &amp; angka dari Team Lead tim tujuan.</p>
      </div>

      <%= form_with url: join_teams_path, method: :post, class: "space-y-4" do %>
        <div>
          <%= label_tag :invite_code, "Kode Undangan (6 Karakter)", class: ui_label_class("uppercase tracking-wider") %>
          <%= text_field_tag :invite_code, nil,
            required: true,
            maxlength: 6,
            autocomplete: "off",
            placeholder: "A7K9P2",
            class: ui_input_class("mt-1.5 py-2.5 text-center font-mono text-base font-semibold uppercase tracking-[0.35em]") %>
        </div>

        <%= submit_tag "Gabung ke Tim", class: ui_btn_primary_class("w-full py-2.5") %>
      <% end %>
    </div>

    <div class="<%= ui_card_class('p-6 space-y-4') %>">
      <div>
        <h3 class="font-display text-lg font-semibold text-on-surface">Buat Tim Baru</h3>
        <p class="mt-1 text-xs text-on-surface-variant">Otomatis menjadi Team Lead dan menghasilkan kode undangan baru.</p>
      </div>

      <%= form_with model: (@new_team || Team.new), url: teams_path, class: "space-y-3.5" do |form| %>
        <div>
          <%= form.label :name, "Nama Tim", class: ui_label_class("uppercase tracking-wider") %>
          <%= form.text_field :name,
            required: true,
            placeholder: "Misal: Tim Mobile Squad",
            class: ui_input_class("mt-1.5") %>
        </div>

        <div>
          <%= form.label :description, "Deskripsi Singkat (Opsional)", class: ui_label_class("uppercase tracking-wider") %>
          <%= form.text_field :description,
            placeholder: "Keterangan tim atau sprint...",
            class: ui_input_class("mt-1.5") %>
        </div>

        <%= form.submit "Buat Tim Baru", class: ui_btn_secondary_class("w-full py-2.5 text-sm") %>
      <% end %>
    </div>
  </div>
</div>
