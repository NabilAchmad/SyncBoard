<% content_for :title, "Masuk — SyncBoard" %>

<div class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 shadow-sm">
  <h2 class="text-2xl font-bold text-slate-900">Masuk ke SyncBoard</h2>
  <p class="mt-1 text-sm text-slate-500">Kelola Kanban Board dan gabung ruang diskusi tim Anda.</p>

  <%= form_with url: session_url, class: "mt-6 space-y-4" do |form| %>
    <div>
      <%= form.label :email_address, "Email Tim", class: "block text-sm font-medium text-slate-700" %>
      <%= form.email_field :email_address,
        required: true,
        autofocus: true,
        autocomplete: "username",
        placeholder: "nama@perusahaan.com",
        value: params[:email_address],
        class: "mt-1 block w-full rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20" %>
    </div>

    <div>
      <div class="flex items-center justify-between">
        <%= form.label :password, "Password", class: "block text-sm font-medium text-slate-700" %>
        <%= link_to "Lupa password?", new_password_path, class: "text-xs font-medium text-indigo-600 hover:text-indigo-500" %>
      </div>
      <%= form.password_field :password,
        required: true,
        autocomplete: "current-password",
        placeholder: "Masukkan password",
        maxlength: 72,
        class: "mt-1 block w-full rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20" %>
    </div>

    <div class="pt-2">
      <%= form.submit "Masuk Workspace",
        class: "w-full rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-indigo-500 transition cursor-pointer shadow-xs" %>
    </div>
  <% end %>

  <p class="mt-6 text-center text-sm text-slate-500">
    Anggota baru?
    <%= link_to "Daftar akun di sini", new_registration_path, class: "font-semibold text-indigo-600 hover:text-indigo-500" %>
  </p>
</div>
