<% content_for :title, "Edit #{@task.code} | SyncBoard" %>
<% content_for :page_title, "Edit Task #{@task.code}" %>

<div class="mx-auto max-w-2xl space-y-4">
  <div class="<%= ui_card_class('p-6 sm:p-8') %>">
    <div class="mb-5 flex flex-wrap items-start justify-between gap-3 border-b border-outline-variant pb-4">
      <div>
        <span class="rounded-md border border-outline-variant bg-inset px-2.5 py-1 font-mono text-xs font-semibold text-on-surface"><%= @task.code %></span>
        <p class="mt-2.5 text-xs text-on-surface-muted">Proyek: <span class="font-semibold text-on-surface"><%= @project.name %></span></p>
        <p class="mt-0.5 text-xs text-on-surface-muted">
          Dibuat: <span class="font-mono font-medium text-on-surface"><%= format_date_id(@task.created_at, include_time: true) %> WIB</span>
          <% if @task.source_meeting %>
            · ACC Rapat <span class="font-mono font-semibold text-primary-text"><%= @task.source_meeting.room_code %></span>
            (<%= format_date_id(@task.source_meeting.approved_at || @task.created_at, include_time: true) %> WIB)
          <% end %>
        </p>
      </div>
      <%= button_to "Hapus Task", project_task_path(@project, @task),
        method: :delete,
        form: { data: { turbo_confirm: "Hapus task #{@task.code} secara permanen?" } },
        class: ui_btn_danger_class %>
    </div>

    <%= form_with model: [@project, @task], class: "space-y-4" do |form| %>
      <%= render "shared/form_errors", record: @task %>

      <div>
        <%= form.label :title, "Judul Task", class: ui_label_class("text-sm") %>
        <%= form.text_field :title, required: true, class: ui_input_class("mt-1.5") %>
      </div>

      <div>
        <%= form.label :description, "Deskripsi / Catatan Teknis", class: ui_label_class("text-sm") %>
        <%= form.text_area :description, rows: 4, class: ui_input_class("mt-1.5") %>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <%= form.label :column_status, "Kolom Kanban", class: ui_label_class("text-sm") %>
          <%= form.select :column_status, Task::COLUMNS.map { |k, v| [v, k] }, {}, class: ui_input_class("mt-1.5") %>
        </div>

        <div>
          <%= form.label :priority, "Prioritas", class: ui_label_class("text-sm") %>
          <%= form.select :priority, Task::PRIORITIES.map { |k, v| [v, k] }, {}, class: ui_input_class("mt-1.5") %>
        </div>

        <div>
          <%= form.label :assignee_id, "PIC / Assignee", class: ui_label_class("text-sm") %>
          <%= form.select :assignee_id,
            options_from_collection_for_select(@team_members, :id, :full_name, @task.assignee_id),
            { include_blank: "Belum ditentukan" },
            class: ui_input_class("mt-1.5") %>
        </div>

        <div>
          <%= form.label :due_date, "Target Penyelesaian (Due Date)", class: ui_label_class("text-sm") %>
          <%= form.date_field :due_date, class: ui_input_class("mt-1.5") %>
          <% if @task.due_date.present? %>
            <div class="mt-2"><%= task_due_badge(@task) %></div>
          <% end %>
        </div>
      </div>

      <div class="flex flex-wrap items-center justify-end gap-3 border-t border-outline-variant pt-4">
        <%= link_to "Kembali ke Kanban", project_path(@project), class: ui_btn_secondary_class("px-4 py-2 text-sm") %>
        <%= form.submit "Simpan Task", class: ui_btn_primary_class("px-5 py-2") %>
      </div>
    <% end %>
  </div>
</div>
