<article id="<%= dom_id(task) %>"
         draggable="true"
         data-kanban-target="card"
         data-task-id="<%= task.id %>"
         data-column="<%= task.column_status %>"
         data-move-url="<%= move_project_task_path(project, task) %>"
         data-action="dragstart->kanban#dragStart dragend->kanban#dragEnd"
         class="group cursor-grab active:cursor-grabbing rounded-xl border p-3.5 shadow-2xs hover:shadow-xs transition <%= task_card_surface_class(task) %>">
  <div class="flex items-start justify-between gap-2">
    <span class="rounded-md bg-white/90 px-2 py-0.5 font-mono text-[11px] font-bold text-slate-700 ring-1 ring-inset ring-slate-200/80"><%= task.code %></span>
    <div class="flex items-center gap-1.5">
      <%= task_priority_badge(task.priority) %>
      <%= link_to "Edit", edit_project_task_path(project, task), class: "rounded px-1.5 py-0.5 text-[11px] font-medium text-slate-600 hover:bg-white/80 hover:text-indigo-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500" %>
    </div>
  </div>

  <h4 class="mt-2 text-sm font-bold leading-snug text-slate-900"><%= task.title %></h4>

  <% if task.description.present? %>
    <p class="mt-1 line-clamp-2 text-xs leading-relaxed text-slate-600"><%= task.description %></p>
  <% end %>

  <div class="mt-2.5 flex flex-wrap items-center gap-1.5">
    <span class="inline-flex items-center rounded-md bg-white/80 px-2 py-0.5 text-[10px] font-medium text-slate-600 ring-1 ring-inset ring-slate-200/80"
          title="Dibuat <%= format_date_id(task.created_at, include_time: true) %> WIB">
      Dibuat <%= format_date_id(task.created_at) %>
    </span>
    <% if task.source_meeting %>
      <%= link_to project_meeting_path(project, task.source_meeting),
        title: "Hasil ACC Rapat pada #{format_date_id(task.source_meeting.approved_at || task.created_at, include_time: true)} WIB",
        class: "inline-flex items-center rounded-full bg-emerald-50 px-2 py-0.5 text-[10px] font-semibold text-emerald-800 ring-1 ring-inset ring-emerald-600/20 hover:bg-emerald-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600" do %>
        ACC Rapat <%= task.source_meeting.room_code %> · <%= format_date_id(task.source_meeting.approved_at || task.created_at) %>
      <% end %>
    <% end %>
  </div>

  <div class="mt-3 flex flex-wrap items-center justify-between gap-2 border-t border-slate-200/70 pt-2.5">
    <% if task.assignee %>
      <div class="flex items-center gap-1.5 min-w-0">
        <%= user_avatar(task.assignee, size_class: "w-6 h-6", text_class: "text-[10px]", team: project.team) %>
        <span class="truncate text-xs font-medium text-slate-700"><%= task.assignee.full_name %></span>
      </div>
    <% else %>
      <span class="text-[11px] italic text-slate-600">Belum ada PIC</span>
    <% end %>

    <% if task.due_date %>
      <div class="shrink-0"><%= task_due_badge(task) %></div>
    <% end %>
  </div>
</article>

