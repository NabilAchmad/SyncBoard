<article id="<%= dom_id(task) %>"
         draggable="true"
         data-kanban-target="card"
         data-task-id="<%= task.id %>"
         data-assignee-id="<%= task.assignee_id %>"
         data-column="<%= task.column_status %>"
         data-move-url="<%= move_project_task_path(project, task) %>"
         data-action="dragstart->kanban#dragStart dragend->kanban#dragEnd"
         class="group cursor-grab active:cursor-grabbing rounded-[10px] border p-3 shadow-2xs transition <%= task_card_surface_class(task) %>">
  <div class="flex items-center justify-between gap-2">
    <div class="flex items-center gap-1.5 min-w-0">
      <span class="font-mono text-[11px] font-semibold text-on-surface-muted"><%= task.code %></span>
      <%= task_priority_badge(task.priority) %>
    </div>

    <%= link_to "Edit", edit_project_task_path(project, task),
      class: "inline-flex min-h-11 sm:min-h-6 items-center rounded px-1.5 text-[11px] font-medium text-on-surface-muted hover:bg-hover hover:text-on-surface focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary shrink-0" %>
  </div>

  <h4 class="mt-2 font-display text-[14px] font-semibold leading-snug text-on-surface"><%= task.title %></h4>

  <% if task.description.present? %>
    <p class="mt-1 line-clamp-1 text-[11px] text-on-surface-variant"><%= task.description %></p>
  <% end %>

  <div class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-[10px] text-on-surface-muted">
    <span class="font-mono" title="Dibuat <%= format_date_id(task.created_at, include_time: true) %> WIB">
      Dibuat <%= format_date_id(task.created_at) %>
    </span>
    <% if task.source_meeting %>
      <%= link_to project_meeting_path(project, task.source_meeting),
        title: "Hasil ACC Rapat pada #{format_date_id(task.source_meeting.approved_at || task.created_at, include_time: true)} WIB",
        class: "inline-flex min-h-9 sm:min-h-5 items-center gap-1 rounded border border-primary-border bg-primary-soft px-1.5 py-0.5 font-medium text-on-primary-soft hover:bg-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary" do %>
        <%= material_icon("videocam", size: 11) %>
        <span>ACC Rapat <%= task.source_meeting.room_code %></span>
      <% end %>
    <% end %>
  </div>

  <div class="mt-2.5 flex items-center justify-between gap-2 border-t border-outline-variant/60 pt-2">
    <% if task.assignee %>
      <div class="flex min-w-0 items-center gap-1.5">
        <%= user_avatar(task.assignee, size_class: "w-5 h-5", text_class: "text-[9px]", team: project.team) %>
        <span class="truncate text-[11px] font-medium text-on-surface-variant"><%= task.assignee.full_name %></span>
      </div>
    <% else %>
      <span class="text-[11px] text-on-surface-muted">Belum ada PIC</span>
    <% end %>

    <% if task.due_date %>
      <div class="shrink-0"><%= task_due_badge(task) %></div>
    <% end %>
  </div>
</article>
