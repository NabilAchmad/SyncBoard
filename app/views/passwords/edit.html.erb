<% content_for :title, "Buat Password Baru — SyncBoard" %>

<div class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 shadow-sm">
  <h2 class="text-2xl font-bold text-slate-900">Atur Password Baru</h2>
  <p class="mt-1 text-sm text-slate-500">Masukkan password baru Anda untuk mengakses kembali akun SyncBoard.</p>

  <%= form_with url: password_path(params[:token]), method: :put, class: "mt-6 space-y-4" do |form| %>
    <div>
      <%= form.label :password, "Password Baru", class: "block text-sm font-medium text-slate-700" %>
      <%= form.password_field :password,
        required: true,
        autocomplete: "new-password",
        placeholder: "Masukkan password baru",
        maxlength: 72,
        class: "mt-1 block w-full rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20" %>
    </div>

    <div>
      <%= form.label :password_confirmation, "Ulangi Password Baru", class: "block text-sm font-medium text-slate-700" %>
      <%= form.password_field :password_confirmation,
        required: true,
        autocomplete: "new-password",
        placeholder: "Ulangi password baru",
        maxlength: 72,
        class: "mt-1 block w-full rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20" %>
    </div>

    <div class="pt-2">
      <%= form.submit "Simpan Password",
        class: "w-full rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-indigo-500 transition cursor-pointer shadow-xs" %>
    </div>
  <% end %>
</div>
