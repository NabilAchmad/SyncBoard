<% content_for :title, "Buat Password Baru | SyncBoard" %>

<div class="rounded-[12px] border border-outline-variant bg-panel p-7 sm:p-8 shadow-sm">
  <div class="mb-6 flex flex-col items-center text-center">
    <%= link_to new_session_path, class: "mb-3 inline-flex h-10 w-10 items-center justify-center rounded-[12px] border border-outline-variant bg-inset font-mono text-xs font-bold tracking-tight text-primary-text transition hover:border-primary-border focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary" do %>
      SB
    <% end %>
    <h1 class="font-display text-lg font-semibold tracking-tight text-on-surface">Atur Password Baru</h1>
    <p class="mt-1 text-xs leading-relaxed text-on-surface-variant">Masukkan password baru Anda untuk mengakses kembali akun SyncBoard.</p>
  </div>

  <%= form_with url: password_path(params[:token]), method: :put, class: "space-y-4" do |form| %>
    <div>
      <%= form.label :password, "Password Baru", class: "block text-xs font-medium text-on-surface-variant" %>
      <%= form.password_field :password,
        required: true,
        autocomplete: "new-password",
        placeholder: "Masukkan password baru",
        maxlength: 72,
        class: "mt-1.5 block w-full min-h-11 sm:min-h-[38px] rounded-[12px] border border-outline-variant bg-input px-3 py-2 text-[13px] text-on-surface placeholder:text-on-surface-muted transition focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/25" %>
    </div>

    <div>
      <%= form.label :password_confirmation, "Ulangi Password Baru", class: "block text-xs font-medium text-on-surface-variant" %>
      <%= form.password_field :password_confirmation,
        required: true,
        autocomplete: "new-password",
        placeholder: "Ulangi password baru",
        maxlength: 72,
        class: "mt-1.5 block w-full min-h-11 sm:min-h-[38px] rounded-[12px] border border-outline-variant bg-input px-3 py-2 text-[13px] text-on-surface placeholder:text-on-surface-muted transition focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/25" %>
    </div>

    <div class="pt-1">
      <%= form.submit "Simpan Password", class: "inline-flex w-full min-h-11 sm:min-h-10 items-center justify-center rounded-[12px] bg-primary px-4 py-2 text-sm font-semibold text-on-primary shadow-xs transition hover:bg-primary-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-panel cursor-pointer" %>
    </div>
  <% end %>
</div>
