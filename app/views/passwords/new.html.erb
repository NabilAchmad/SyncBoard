<% content_for :title, "Lupa Password | SyncBoard" %>

<div class="rounded-[12px] border border-outline-variant bg-panel p-7 sm:p-8 shadow-sm">
  <div class="mb-6 flex flex-col items-center text-center">
    <%= link_to new_session_path, class: "mb-3 inline-flex h-12 w-12 items-center justify-center rounded-[12px] transition hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary" do %>
      <%= brand_logo(size_class: "h-12 w-12") %>
    <% end %>
    <h1 class="font-display text-lg font-semibold tracking-tight text-on-surface">Reset Password</h1>
    <p class="mt-1 text-xs leading-relaxed text-on-surface-variant">Masukkan email tim Anda untuk menerima tautan pengaturan ulang password.</p>
  </div>

  <%= form_with url: passwords_path, class: "space-y-4" do |form| %>
    <div>
      <%= form.label :email_address, "Email Tim", class: "block text-xs font-medium text-on-surface-variant" %>
      <%= form.email_field :email_address,
        required: true,
        autofocus: true,
        autocomplete: "username",
        placeholder: "nama@perusahaan.com",
        value: params[:email_address],
        class: "mt-1.5 block w-full min-h-11 sm:min-h-[38px] rounded-[12px] border border-outline-variant bg-input px-3 py-2 text-[13px] text-on-surface placeholder:text-on-surface-muted transition focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/25" %>
    </div>

    <div class="pt-1">
      <%= form.submit "Kirim Instruksi Reset", class: "inline-flex w-full min-h-11 sm:min-h-10 items-center justify-center rounded-[12px] bg-primary px-4 py-2 text-sm font-semibold text-on-primary shadow-xs transition hover:bg-primary-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-panel cursor-pointer" %>
    </div>
  <% end %>

  <div class="mt-6 border-t border-outline-variant pt-5 text-center text-xs text-on-surface-variant">
    <%= link_to "Kembali ke halaman masuk", new_session_path, class: "inline-flex min-h-11 sm:min-h-0 items-center rounded px-1 font-semibold text-primary-text hover:underline underline-offset-4 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary" %>
  </div>
</div>
