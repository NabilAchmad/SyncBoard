<div class="rounded-[12px] border border-outline-variant bg-column p-3.5 space-y-3">
  <div>
    <p class="text-xs font-semibold text-on-surface">Tema Tampilan</p>
    <p class="text-[11px] text-on-surface-muted">Pilih tampilan terang, gelap, atau ikuti sistem perangkat Anda.</p>
  </div>

  <div role="group" aria-label="Pengaturan tema tampilan" class="grid grid-cols-3 gap-1.5 rounded-[10px] bg-inset p-1">
    <button type="button"
            data-theme-target="option"
            data-theme-mode="light"
            data-action="theme#select"
            aria-pressed="<%= theme_preference == 'light' %>"
            class="flex min-h-11 sm:min-h-9 items-center justify-center gap-1.5 rounded-[8px] px-2.5 py-1.5 text-xs font-semibold transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary cursor-pointer <%= theme_preference == 'light' ? 'border border-outline-variant bg-card text-primary-text shadow-2xs' : 'text-on-surface-muted hover:text-on-surface' %>">
      <%= material_icon("light_mode", size: 16) %>
      <span>Terang</span>
    </button>

    <button type="button"
            data-theme-target="option"
            data-theme-mode="dark"
            data-action="theme#select"
            aria-pressed="<%= theme_preference == 'dark' %>"
            class="flex min-h-11 sm:min-h-9 items-center justify-center gap-1.5 rounded-[8px] px-2.5 py-1.5 text-xs font-semibold transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary cursor-pointer <%= theme_preference == 'dark' ? 'border border-outline-variant bg-card text-primary-text shadow-2xs' : 'text-on-surface-muted hover:text-on-surface' %>">
      <%= material_icon("dark_mode", size: 16) %>
      <span>Gelap</span>
    </button>

    <button type="button"
            data-theme-target="option"
            data-theme-mode="system"
            data-action="theme#select"
            aria-pressed="<%= theme_preference == 'system' %>"
            class="flex min-h-11 sm:min-h-9 items-center justify-center gap-1.5 rounded-[8px] px-2.5 py-1.5 text-xs font-semibold transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary cursor-pointer <%= theme_preference == 'system' ? 'border border-outline-variant bg-card text-primary-text shadow-2xs' : 'text-on-surface-muted hover:text-on-surface' %>">
      <%= material_icon("contrast", size: 16) %>
      <span>Sistem</span>
    </button>
  </div>
</div>
