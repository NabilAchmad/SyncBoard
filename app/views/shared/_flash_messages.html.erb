<% if flash[:notice].present? %>
  <div class="mb-5 rounded-xl border border-primary-border bg-primary-soft px-4 py-3 text-sm font-medium text-on-primary-soft" id="notice" role="status">
    <%= flash[:notice] %>
  </div>
<% end %>

<% if flash[:alert].present? %>
  <div class="mb-5 rounded-xl border border-danger-border bg-danger-soft px-4 py-3 text-sm font-medium text-on-danger-soft" id="alert" role="alert">
    <%= flash[:alert] %>
  </div>
<% end %>
