<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Literata:ital,opsz,wght@0,7..72,500..700;1,7..72,500..700&family=Nunito+Sans:ital,opsz,wght@0,6..12,400..800;1,6..12,400..800&display=swap" rel="stylesheet">
<link rel="icon" href="/icon.svg?v=2" type="image/svg+xml">
<link rel="icon" href="/icon.png?v=2" type="image/png">
<link rel="apple-touch-icon" href="/icon.png?v=2">
<%= javascript_tag do %>
  (function() {
    try {
      var valid = ["light", "dark", "system"];
      var stored = window.localStorage ? window.localStorage.getItem("syncboard_theme") : null;
      var cookieMatch = document.cookie.match(/(?:^|;\s*)syncboard_theme=([^;]+)/);
      var fromAttr = document.documentElement.getAttribute("data-theme-preference");
      var mode = valid.indexOf(stored) !== -1 ? stored : (cookieMatch && valid.indexOf(cookieMatch[1]) !== -1 ? cookieMatch[1] : (valid.indexOf(fromAttr) !== -1 ? fromAttr : "light"));
      var isDark = mode === "dark" || (mode === "system" && window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches);
      document.documentElement.classList.toggle("dark", isDark);
      document.documentElement.style.colorScheme = isDark ? "dark" : "light";
      document.documentElement.setAttribute("data-theme-preference", mode);
    } catch (_e) {}
  })();
<% end %>

