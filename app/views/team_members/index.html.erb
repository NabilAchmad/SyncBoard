<% content_for :title, "Kelola Tim #{current_team.name} — SyncBoard" %>
<% content_for :page_title, "Anggota & Kode Undangan · #{current_team.name}" %>

<div class="space-y-6">
  <!-- Kode Undangan & Pengaturan Tim -->
  <div class="grid gap-6 lg:grid-cols-12">
    <div class="rounded-2xl border border-indigo-200 bg-white p-6 shadow-xs lg:col-span-5 space-y-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-indigo-600">Invitation Code</p>
        <h2 class="mt-1 text-lg font-extrabold text-slate-900">Kode Undangan Tim</h2>
        <p class="mt-1 text-xs text-slate-500">Bagikan kode 6 karakter ini agar rekan tim dapat masuk ke workspace <strong><%= current_team.name %></strong>.</p>
      </div>

      <div class="flex items-center justify-between gap-3 rounded-2xl border border-indigo-200 bg-indigo-50/70 px-4 py-3.5">
        <span class="font-mono text-2xl font-extrabold tracking-[0.28em] text-indigo-900"><%= current_team.invite_code %></span>
        <button type="button"
                data-action="sidebar#copyCode"
                data-code="<%= current_team.invite_code %>"
                class="rounded-xl bg-indigo-600 px-3.5 py-2 text-xs font-semibold text-white hover:bg-indigo-500 transition cursor-pointer">
          Salin Kode
        </button>
      </div>

      <div class="flex items-center justify-between gap-2 pt-1">
        <p class="text-[11px] text-slate-400">Kode lama otomatis tidak berlaku jika dibuat ulang.</p>
        <%= button_to "Buat Kode Baru", regenerate_code_team_path(current_team),
          method: :post,
          class: "rounded-xl border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50 transition cursor-pointer shrink-0" %>
      </div>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-xs lg:col-span-7 space-y-4">
      <div>
        <h2 class="text-lg font-extrabold text-slate-900">Pengaturan Tim (<%= @memberships.size %> Anggota)</h2>
        <p class="mt-1 text-xs text-slate-500">
          Sebagai Team Lead di tim ini, Anda dapat memperbarui nama tim, mengangkat <strong>Team Lead</strong> lain, atau mengeluarkan anggota.
        </p>
      </div>

      <%= form_with model: current_team, url: team_path(current_team), method: :patch, class: "grid gap-3 sm:grid-cols-12" do |form| %>
        <div class="sm:col-span-5">
          <%= form.label :name, "Nama Tim", class: "block text-xs font-medium text-slate-600" %>
          <%= form.text_field :name, required: true,
            class: "mt-1 block w-full rounded-xl border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none" %>
        </div>
        <div class="sm:col-span-5">
          <%= form.label :description, "Deskripsi", class: "block text-xs font-medium text-slate-600" %>
          <%= form.text_field :description, placeholder: "Deskripsi tim...",
            class: "mt-1 block w-full rounded-xl border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none" %>
        </div>
        <div class="sm:col-span-2 flex items-end">
          <%= form.submit "Simpan", class: "w-full rounded-xl bg-slate-900 px-3 py-2 text-sm font-semibold text-white hover:bg-indigo-600 transition cursor-pointer" %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Tabel Anggota Tim Ini -->
  <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xs">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-slate-200 text-left text-xs">
        <thead class="bg-slate-50 text-[11px] font-bold uppercase tracking-wider text-slate-500">
          <tr>
            <th class="px-5 py-3.5">Anggota</th>
            <th class="px-5 py-3.5">Divisi &amp; Jabatan</th>
            <th class="px-5 py-3.5">Role di Tim Ini</th>
            <th class="px-5 py-3.5">Bergabung</th>
            <th class="px-5 py-3.5 text-right">Aksi</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @memberships.each do |membership| %>
            <% member = membership.user %>
            <tr class="hover:bg-slate-50/70">
              <td class="px-5 py-3.5">
                <div class="flex items-center gap-3">
                  <%= user_avatar(member, size_class: "w-9 h-9", text_class: "text-xs", lead: membership.lead?) %>
                  <div>
                    <p class="font-bold text-slate-900">
                      <%= member.full_name %>
                      <% if member == current_user %>
                        <span class="ml-1 rounded bg-slate-100 px-1.5 py-0.5 text-[10px] font-semibold text-slate-600">Anda</span>
                      <% end %>
                    </p>
                    <p class="text-[11px] text-slate-500"><%= member.employee_code %> · <%= member.email_address %></p>
                  </div>
                </div>
              </td>
              <td class="px-5 py-3.5 text-slate-600">
                <p class="font-medium text-slate-800"><%= member.job_title %></p>
                <p class="text-[11px] text-slate-400"><%= member.department %></p>
              </td>
              <td class="px-5 py-3.5">
                <span class="inline-flex rounded-full px-2.5 py-0.5 text-[11px] font-semibold <%= membership.lead? ? 'bg-indigo-50 text-indigo-700 ring-1 ring-inset ring-indigo-600/20' : 'bg-slate-100 text-slate-700' %>">
                  <%= membership.role_label %>
                </span>
              </td>
              <td class="px-5 py-3.5 text-slate-500">
                <%= membership.joined_at.strftime("%d %b %Y") %>
              </td>
              <td class="px-5 py-3.5 text-right">
                <% if member == current_user %>
                  <span class="text-[11px] italic text-slate-400">Akun aktif Anda</span>
                <% else %>
                  <div class="inline-flex flex-wrap items-center justify-end gap-2">
                    <% next_role = membership.lead? ? "member" : "lead" %>
                    <%= button_to(membership.lead? ? "Jadikan Member" : "Angkat Team Lead",
                      team_member_path(membership),
                      method: :patch,
                      params: { team_membership: { role: next_role } },
                      class: "rounded-lg border border-indigo-200 bg-indigo-50 px-2.5 py-1 text-[11px] font-semibold text-indigo-700 hover:bg-indigo-100 cursor-pointer") %>

                    <%= button_to "Keluarkan",
                      team_member_path(membership),
                      method: :delete,
                      class: "rounded-lg border border-rose-200 bg-rose-50 px-2.5 py-1 text-[11px] font-semibold text-rose-700 hover:bg-rose-100 cursor-pointer" %>
                  </div>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
