<% if message.kind == "system" %>
  <div id="<%= dom_id(message) %>" class="flex justify-center py-0.5">
    <span class="rounded-full border border-outline-variant bg-inset px-2.5 py-0.5 text-[10px] font-medium text-on-surface-muted">
      <%= message.body %> · <span class="font-mono"><%= message.created_at.strftime("%H:%M") %></span>
    </span>
  </div>
<% else %>
  <% container_style = case message.kind
    when "decision" then "border-primary-border bg-primary-soft"
    when "note" then "border-warning-border bg-warning-soft"
    else "border-outline-variant bg-inset"
  end %>
  <% badge_style = case message.kind
    when "decision" then "border-primary-border bg-card text-on-primary-soft"
    when "note" then "border-warning-border bg-card text-on-warning-soft"
    else "border-outline-variant bg-card text-on-surface-variant"
  end %>

  <div id="<%= dom_id(message) %>" class="rounded-[10px] border <%= container_style %> p-2.5 text-xs">
    <div class="flex items-center justify-between gap-2">
      <div class="flex min-w-0 items-center gap-1.5">
        <%= user_avatar(message.user, size_class: "w-5 h-5", text_class: "text-[9px]", team: message.meeting.project.team) %>
        <span class="truncate font-semibold text-on-surface"><%= message.user.full_name %></span>
        <span class="rounded border px-1.5 py-0.5 text-[10px] font-semibold <%= badge_style %>"><%= message.kind_label %></span>
      </div>
      <span class="shrink-0 font-mono text-[10px] text-on-surface-muted"><%= message.created_at.strftime("%H:%M") %></span>
    </div>
    <p class="mt-1 whitespace-pre-line leading-relaxed text-on-surface"><%= message.body %></p>
  </div>
<% end %>
