<% if message.kind == "system" %>
  <div id="<%= dom_id(message) %>" class="flex justify-center py-1">
    <span class="rounded-full bg-slate-100 px-3 py-1 text-[11px] font-medium text-slate-600">
      <%= message.body %> · <%= message.created_at.strftime("%H:%M") %>
    </span>
  </div>
<% else %>
  <% container_style = case message.kind
    when "decision" then "border-emerald-200 bg-emerald-50/70"
    when "note" then "border-amber-200 bg-amber-50/70"
    else "border-slate-200 bg-white"
  end %>
  <% pill_style = case message.kind
    when "decision" then "bg-emerald-600 text-white"
    when "note" then "bg-amber-500 text-white"
    else "bg-slate-100 text-slate-600"
  end %>

  <div id="<%= dom_id(message) %>" class="rounded-xl border <%= container_style %> p-3 text-xs">
    <div class="flex items-center justify-between gap-2">
      <div class="flex items-center gap-2 min-w-0">
        <%= user_avatar(message.user, size_class: "w-6 h-6", text_class: "text-[10px]", team: message.meeting.project.team) %>
        <span class="truncate font-bold text-slate-900"><%= message.user.full_name %></span>
        <span class="rounded px-1.5 py-0.5 text-[10px] font-bold <%= pill_style %>"><%= message.kind_label %></span>
      </div>
      <span class="shrink-0 text-[10px] text-slate-400"><%= message.created_at.strftime("%H:%M") %></span>
    </div>
    <p class="mt-1.5 whitespace-pre-line leading-relaxed text-slate-700"><%= message.body %></p>
  </div>
<% end %>

