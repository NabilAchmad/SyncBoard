<% ready_to_complete = project.all_tasks_done? %>
<div id="<%= dom_id(project, :completion_banner) %>"
     data-kanban-toolbar-target="completionAction"
     data-project-completed="<%= project.completed? %>"
     class="<%= 'hidden' unless project.completed? || ready_to_complete %>">
  <% if project.completed? %>
    <span class="inline-flex min-h-11 sm:min-h-9 items-center gap-1.5 rounded-[10px] border border-primary-border bg-primary-soft px-3 py-1.5 text-xs font-semibold text-on-primary-soft">
      <%= material_icon("task_alt", size: 16) %>
      <span>Proyek Selesai</span>
    </span>
  <% else %>
    <div class="lead-only">
      <%= button_to complete_project_path(project),
        method: :patch,
        class: "inline-flex min-h-11 sm:min-h-9 items-center gap-1.5 rounded-[10px] bg-primary px-3 py-1.5 text-xs font-semibold text-on-primary shadow-2xs hover:bg-primary-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary transition cursor-pointer" do %>
        <%= material_icon("task_alt", size: 16) %>
        <span>Done</span>
      <% end %>
    </div>
  <% end %>
</div>

