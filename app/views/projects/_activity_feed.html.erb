<div id="<%= dom_id(project, :activity_feed) %>" class="rounded-[12px] border border-outline-variant bg-panel p-5 lg:col-span-5">
  <div class="flex items-center justify-between border-b border-outline-variant pb-3">
    <h3 class="font-display text-sm font-semibold text-on-surface">Aktivitas Board</h3>
    <span class="font-mono text-[11px] text-on-surface-muted"><%= activity_logs.size %></span>
  </div>

  <% if activity_logs.any? %>
    <ul class="mt-3 space-y-2.5">
      <% activity_logs.each do |log| %>
        <li class="flex items-start gap-2.5 text-xs">
          <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full <%= log.meeting_id.present? ? 'bg-primary' : 'bg-outline' %>"></span>
          <div class="min-w-0 flex-1">
            <p class="leading-relaxed text-on-surface"><%= log.summary %></p>
            <p class="mt-0.5 font-mono text-[10px] text-on-surface-muted">
              <%= log.created_at.strftime("%d %b %H:%M") %>
              <% if log.meeting %>
                · Room <%= log.meeting.room_code %>
              <% end %>
            </p>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-4 text-xs text-on-surface-muted">Belum ada aktivitas pada proyek ini.</p>
  <% end %>
</div>
