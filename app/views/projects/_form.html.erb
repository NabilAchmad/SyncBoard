<div class="<%= ui_card_class('p-6 sm:p-8') %>">
  <div class="border-b border-outline-variant pb-4">
    <h2 class="font-display text-xl font-semibold text-on-surface">
      <%= project.persisted? ? "Pengaturan Proyek #{project.key}" : "Detail Proyek Baru" %>
    </h2>
    <p class="mt-1 text-xs text-on-surface-variant">
      <%= project.persisted? ? "Perbarui informasi, kode prefix, atau status proyek tim." : "Siapkan board Kanban baru beserta prefix unik untuk seluruh task." %>
    </p>
  </div>

  <%= form_with model: project, class: "mt-6 space-y-5" do |form| %>
    <%= render "shared/form_errors", record: project %>

    <div class="grid gap-4 sm:grid-cols-3">
      <div class="sm:col-span-2">
        <%= form.label :name, "Nama Proyek", class: ui_label_class("text-sm") %>
        <%= form.text_field :name,
          required: true,
          autofocus: true,
          placeholder: "Masukkan nama proyek",
          class: ui_input_class("mt-1.5 py-2.5") %>
      </div>

      <div>
        <%= form.label :key, "Kode Board (2-6 huruf)", class: ui_label_class("text-sm") %>
        <%= form.text_field :key,
          placeholder: "SYNC",
          maxlength: 6,
          class: ui_input_class("mt-1.5 py-2.5 uppercase font-mono") %>
        <p class="mt-1.5 text-xs text-on-surface-muted">Dipakai sebagai prefix kode task, misal SYNC-1.</p>
      </div>
    </div>

    <div>
      <%= form.label :description, "Deskripsi Singkat Proyek", class: ui_label_class("text-sm") %>
      <%= form.text_area :description,
        rows: 3,
        placeholder: "Tujuan proyek, target sprint, atau cakupan pekerjaan tim...",
        class: ui_input_class("mt-1.5 py-2.5") %>
    </div>

    <% if project.persisted? %>
      <div>
        <%= form.label :status, "Status Proyek", class: ui_label_class("text-sm") %>
        <%= form.select :status, Project::STATUSES.map { |k, v| [v, k] }, {}, class: ui_input_class("mt-1.5 py-2.5") %>
      </div>
    <% end %>

    <div class="flex flex-wrap items-center justify-end gap-3 border-t border-outline-variant pt-4">
      <%= link_to "Batal", project.persisted? ? project_path(project) : root_path, class: ui_btn_secondary_class("px-4 py-2 text-sm") %>
      <%= form.submit(project.persisted? ? "Simpan Perubahan" : "Buat Proyek & Buka Kanban", class: ui_btn_primary_class("px-5 py-2")) %>
    </div>
  <% end %>
</div>
