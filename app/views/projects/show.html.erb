<% content_for :title, "#{@project.name} (#{@project.key}): SyncBoard" %>
<% content_for :page_title, "#{@project.key} · #{@project.name}" %>

<%= turbo_stream_from @project, :kanban %>

<div class="space-y-6">
  <!-- Header Proyek + Tombol Buka Ruang Diskusi Video Call -->
  <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 shadow-xs">
    <div class="flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between">
      <div class="space-y-1.5 min-w-0">
        <div class="flex flex-wrap items-center gap-2">
          <span class="rounded-lg bg-indigo-600 px-2.5 py-0.5 text-xs font-extrabold text-white"><%= @project.key %></span>
          <span class="rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-semibold text-emerald-700 ring-1 ring-inset ring-emerald-600/20">
            Kanban Auto-Sync Aktif
          </span>
          <span class="text-xs text-slate-600">Owner: <%= @project.owner.full_name %></span>
        </div>
        <h2 class="text-xl font-extrabold text-slate-900 sm:text-2xl"><%= @project.name %></h2>
        <p class="text-sm text-slate-600"><%= @project.description.presence || "Drag & drop kartu antar kolom, atau buka Ruang Meeting untuk diskusi & ACC rangkuman ke Kanban." %></p>
      </div>

      <!-- Form Mini Buka Ruang Diskusi / Video Call -->
      <div class="rounded-2xl border border-indigo-200 bg-indigo-50/60 p-4 lg:w-[420px] shrink-0">
        <p class="text-xs font-bold uppercase tracking-wider text-indigo-800">Ruang Diskusi & Video Call</p>
        <%= form_with model: [@project, @new_meeting], class: "mt-2 flex flex-col gap-2 sm:flex-row" do |form| %>
          <%= form.text_field :title,
            required: true,
            placeholder: "Judul rapat, misal: Daily Sync Sprint",
            value: "Sync Diskusi #{@project.key}",
            aria: { label: "Judul rapat baru" },
            class: "min-w-0 flex-1 rounded-xl border border-indigo-200 bg-white px-3 py-2 text-xs font-medium text-slate-800 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20" %>
          <%= form.submit "Buka Room",
            class: "rounded-xl bg-indigo-600 px-4 py-2 text-xs font-semibold text-white hover:bg-indigo-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 transition cursor-pointer shrink-0 shadow-xs" %>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Form Tambah Task Cepat -->
  <div class="rounded-2xl border border-slate-200 bg-white p-4 sm:p-5 shadow-xs">
    <div class="flex items-center justify-between gap-2 mb-3">
      <h3 class="text-sm font-bold text-slate-900">Tambah Task Kanban Baru</h3>
      <%= link_to "Pengaturan Proyek", edit_project_path(@project), class: "text-xs font-medium text-slate-500 hover:text-indigo-600" %>
    </div>

    <%= form_with model: [@project, @new_task], class: "grid grid-cols-1 gap-3 sm:grid-cols-12" do |form| %>
      <div class="min-w-0 sm:col-span-4">
        <%= form.label :title, "Judul Task", class: "sr-only" %>
        <%= form.text_field :title,
          required: true,
          placeholder: "Judul task baru...",
          class: "block w-full rounded-xl border border-slate-300 px-3.5 py-2 text-sm text-slate-900 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20" %>
      </div>

      <div class="min-w-0 sm:col-span-2">
        <%= form.label :column_status, "Kolom", class: "sr-only" %>
        <%= form.select :column_status, Task::COLUMNS.map { |k, v| [v, k] }, {},
          class: "block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20" %>
      </div>

      <div class="min-w-0 sm:col-span-2">
        <%= form.label :priority, "Prioritas", class: "sr-only" %>
        <%= form.select :priority, Task::PRIORITIES.map { |k, v| [v, k] }, {},
          class: "block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20" %>
      </div>

      <div class="min-w-0 sm:col-span-2">
        <%= form.label :assignee_id, "PIC", class: "sr-only" %>
        <%= form.select :assignee_id,
          options_from_collection_for_select(@team_members, :id, :full_name),
          { include_blank: "Pilih PIC..." },
          class: "block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20" %>
      </div>

      <div class="min-w-0 sm:col-span-2 flex gap-2">
        <div class="min-w-0 flex-1">
          <%= form.label :due_date, "Target Penyelesaian", class: "sr-only" %>
          <%= form.date_field :due_date,
            aria: { label: "Target Penyelesaian" },
            title: "Target tanggal penyelesaian",
            class: "block w-full rounded-xl border border-slate-300 bg-white px-2.5 py-2 text-sm text-slate-900 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20" %>
        </div>
        <%= form.submit "Tambah",
          class: "shrink-0 rounded-xl bg-slate-900 px-3.5 py-2 text-sm font-semibold text-white hover:bg-indigo-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 transition cursor-pointer" %>
      </div>
    <% end %>
  </div>

  <!-- Kanban Board Real-Time -->
  <%= render "projects/kanban_board", project: @project, tasks_by_column: @tasks_by_column %>

  <!-- Ruang Rapat Proyek & Log Aktivitas -->
  <div class="grid gap-6 lg:grid-cols-12">
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-xs lg:col-span-7">
      <div class="flex items-center justify-between gap-2">
        <div>
          <h3 class="text-base font-bold text-slate-900">Ruang Diskusi & Video Call Proyek</h3>
          <p class="text-xs text-slate-500">Masuk ke ruang rapat untuk diskusi video, buat rangkuman, dan ACC ke Kanban.</p>
        </div>
        <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-600"><%= @meetings.size %> Room</span>
      </div>

      <% if @meetings.any? %>
        <div class="mt-4 divide-y divide-slate-100">
          <% @meetings.each do |meeting| %>
            <div class="flex flex-col gap-3 py-3.5 sm:flex-row sm:items-center sm:justify-between">
              <div class="min-w-0 space-y-1">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="rounded-md bg-slate-100 px-2 py-0.5 font-mono text-[11px] font-bold text-slate-700"><%= meeting.room_code %></span>
                  <%= meeting_status_badge(meeting) %>
                </div>
                <p class="truncate text-sm font-bold text-slate-900"><%= meeting.title %></p>
                <p class="text-xs text-slate-500">
                  Host: <%= meeting.host.full_name %> · <%= meeting.started_at.strftime("%d %b %Y %H:%M") %>
                  <% if meeting.meeting_action_items.any? %>
                    · <%= meeting.meeting_action_items.size %> usulan Kanban
                  <% end %>
                </p>
              </div>

              <div class="flex flex-wrap items-center gap-2 shrink-0">
                <% if meeting.live? && meeting.host_id == current_user.id %>
                  <%= button_to "Akhiri", end_call_project_meeting_path(@project, meeting),
                    method: :post,
                    class: "rounded-xl border border-rose-200 bg-rose-50 px-3 py-2 text-xs font-semibold text-rose-700 hover:bg-rose-100 transition cursor-pointer" %>
                <% end %>

                <%= link_to project_meeting_path(@project, meeting),
                  class: "inline-flex items-center justify-center rounded-xl bg-indigo-600 px-4 py-2 text-xs font-semibold text-white hover:bg-indigo-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 transition" do %>
                  <span><%= meeting.approved? || meeting.ended? ? "Lihat Hasil Rapat" : "Masuk Meeting Room" %></span>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="mt-4 text-xs text-slate-500">Belum ada ruang meeting untuk proyek ini. Buat room baru lewat tombol di atas.</p>
      <% end %>
    </div>

    <%= render "projects/activity_feed", project: @project, activity_logs: @activity_logs %>
  </div>
</div>

