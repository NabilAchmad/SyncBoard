<% content_for :title, "#{@project.name} (#{@project.key}) | SyncBoard" %>
<% content_for :page_title, "#{@project.key} · #{@project.name}" %>
<% content_for :full_bleed, "true" %>

<% total_board_tasks = @tasks_by_column.values.sum(&:size) %>
<% done_tasks = @tasks_by_column.fetch("done", []).size %>
<% done_pct = total_board_tasks.positive? ? ((done_tasks.to_f / total_board_tasks) * 100).round : 0 %>
<% active_meeting = @project.active_meeting %>
<% latest_live_or_recent = active_meeting || @meetings.first %>

<%= turbo_stream_from @project, :kanban %>

<div class="flex flex-1 flex-col"
     data-controller="kanban-toolbar"
     data-action="kanban:moved@window->kanban-toolbar#evaluateCompletion"
     data-kanban-toolbar-current-user-id-value="<%= current_user.id %>">
  <div class="flex flex-col gap-3 border-b border-outline-variant bg-panel px-4 py-3 sm:px-6 lg:flex-row lg:items-center lg:justify-between">
    <div class="flex flex-wrap items-center gap-2.5 min-w-0">
      <span class="h-2 w-2 shrink-0 rounded-full bg-primary" aria-hidden="true"></span>
      <span class="rounded-[6px] border border-outline-variant bg-inset px-2 py-0.5 font-mono text-[11px] font-semibold text-on-surface-variant"><%= @project.key %></span>
      <h2 class="truncate font-display text-base sm:text-lg font-semibold tracking-tight text-on-surface"><%= @project.name %></h2>
      <%= link_to "Pengaturan", edit_project_path(@project),
        class: "inline-flex min-h-11 sm:min-h-7 items-center rounded-[7px] px-2 text-xs font-medium text-on-surface-muted hover:bg-hover hover:text-on-surface focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary" %>

      <span class="hidden h-4 w-px bg-outline-variant sm:inline-block" aria-hidden="true"></span>

      <div role="group" aria-label="Filter cakupan task" class="inline-flex rounded-[9px] border border-outline-variant bg-inset p-0.5">
        <button type="button"
                data-kanban-toolbar-target="scopeTab"
                data-scope="all"
                data-action="kanban-toolbar#filterScope"
                aria-pressed="true"
                class="inline-flex min-h-11 sm:min-h-7 items-center rounded-[7px] border border-outline-variant bg-card px-2.5 py-1 text-xs font-semibold text-on-surface shadow-2xs transition cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary">
          Semua Task
        </button>
        <button type="button"
                data-kanban-toolbar-target="scopeTab"
                data-scope="mine"
                data-action="kanban-toolbar#filterScope"
                aria-pressed="false"
                class="inline-flex min-h-11 sm:min-h-7 items-center rounded-[7px] border border-transparent px-2.5 py-1 text-xs font-semibold text-on-surface-muted hover:text-on-surface transition cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary">
          Task Saya
        </button>
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-2 shrink-0">
      <% if @team_members.any? %>
        <div class="hidden xl:flex items-center -space-x-1.5 mr-1">
          <% @team_members.first(3).each do |member| %>
            <%= user_avatar(member, size_class: "w-7 h-7 ring-2 ring-panel", text_class: "text-[10px]", team: @project.team) %>
          <% end %>
          <% if @team_members.size > 3 %>
            <span class="inline-flex h-7 w-7 items-center justify-center rounded-xl border border-outline-variant bg-inset font-mono text-[10px] font-semibold text-on-surface-muted ring-2 ring-panel">
              +<%= @team_members.size - 3 %>
            </span>
          <% end %>
        </div>
      <% end %>

      <button type="button"
              data-kanban-toolbar-target="toggleButton"
              data-action="kanban-toolbar#toggleQuickAdd"
              aria-expanded="false"
              class="inline-flex min-h-11 sm:min-h-9 items-center gap-1 rounded-[10px] border border-outline-variant bg-card px-3 py-1.5 text-xs font-semibold text-on-surface hover:border-outline hover:bg-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary transition cursor-pointer">
        <%= material_icon("add", size: 16) %>
        <span>Task Baru</span>
      </button>

      <%= render "projects/completion_banner", project: @project %>

      <%= render "projects/meeting_action", project: @project, new_meeting: @new_meeting %>
    </div>
  </div>

  <div class="flex flex-wrap items-center justify-between gap-2 border-b border-outline-variant bg-canvas px-4 py-1.5 text-[11px] text-on-surface-muted sm:px-6">
    <div class="flex flex-wrap items-center gap-3 min-w-0">
      <span class="font-mono"><%= @meetings.size %> Room</span>
      <% if latest_live_or_recent %>
        <span aria-hidden="true">·</span>
        <%= link_to project_meeting_path(@project, latest_live_or_recent), class: "inline-flex items-center gap-1 truncate font-medium text-primary-text hover:underline" do %>
          <%= material_icon("videocam", size: 13) %>
          <span class="truncate"><%= latest_live_or_recent.title %> (<span class="font-mono"><%= latest_live_or_recent.room_code %></span>)</span>
        <% end %>
      <% end %>
    </div>
    <div class="font-mono">
      <%= total_board_tasks %> Task · <%= done_pct %>% Selesai
    </div>
  </div>

  <div data-kanban-toolbar-target="quickAddPanel" class="hidden border-b border-outline-variant bg-panel px-4 py-4 sm:px-6">
    <%= form_with model: [@project, @new_task], class: "space-y-3" do |form| %>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-12">
        <div class="min-w-0 sm:col-span-2 lg:col-span-4">
          <%= form.label :title, "Judul Task", class: "block text-[11px] font-medium text-on-surface-muted mb-1" %>
          <%= form.text_field :title,
            required: true,
            placeholder: "Judul task baru...",
            class: ui_input_class("rounded-[10px] py-2 text-xs") %>
        </div>

        <div class="min-w-0 lg:col-span-2">
          <%= form.label :column_status, "Kolom", class: "block text-[11px] font-medium text-on-surface-muted mb-1" %>
          <%= form.select :column_status, Task::COLUMNS.map { |k, v| [v, k] }, {}, class: ui_input_class("rounded-[10px] py-2 text-xs") %>
        </div>

        <div class="min-w-0 lg:col-span-2">
          <%= form.label :priority, "Prioritas", class: "block text-[11px] font-medium text-on-surface-muted mb-1" %>
          <%= form.select :priority, Task::PRIORITIES.map { |k, v| [v, k] }, {}, class: ui_input_class("rounded-[10px] py-2 text-xs") %>
        </div>

        <div class="min-w-0 lg:col-span-2">
          <%= form.label :assignee_id, "PIC", class: "block text-[11px] font-medium text-on-surface-muted mb-1" %>
          <%= form.select :assignee_id,
            options_from_collection_for_select(@team_members, :id, :full_name),
            { include_blank: "Pilih PIC..." },
            class: ui_input_class("rounded-[10px] py-2 text-xs") %>
        </div>

        <div class="min-w-0 lg:col-span-2">
          <%= form.label :due_date, "Tenggat", class: "block text-[11px] font-medium text-on-surface-muted mb-1" %>
          <%= form.date_field :due_date,
            aria: { label: "Target Penyelesaian" },
            class: ui_input_class("rounded-[10px] px-2.5 py-2 text-xs") %>
        </div>
      </div>

      <div class="flex items-center justify-end gap-2">
        <button type="button"
                data-action="kanban-toolbar#toggleQuickAdd"
                class="inline-flex min-h-11 sm:min-h-8 items-center rounded-[8px] px-3 py-1 text-xs font-medium text-on-surface-muted hover:bg-hover hover:text-on-surface cursor-pointer">
          Batal
        </button>
        <%= form.submit "Tambah Task", class: ui_btn_primary_class("min-h-11 sm:min-h-8 px-4 py-1 text-xs rounded-[8px]") %>
      </div>
    <% end %>
  </div>

  <div class="p-4 sm:p-6 space-y-6">
    <%= render "projects/kanban_board", project: @project, tasks_by_column: @tasks_by_column %>

    <div class="grid gap-5 lg:grid-cols-12">
      <%= render "projects/meetings_panel", project: @project, meetings: @meetings %>

      <%= render "projects/activity_feed", project: @project, activity_logs: @activity_logs %>
    </div>
  </div>
</div>
