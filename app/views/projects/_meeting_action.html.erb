<% active_meeting = project.active_meeting %>
<div id="<%= dom_id(project, :meeting_action) %>" class="flex flex-wrap sm:flex-nowrap items-center gap-1.5">
  <% if active_meeting %>
    <%= link_to project_meeting_path(project, active_meeting),
      title: "Gabung ke #{active_meeting.title} (#{active_meeting.room_code})",
      class: "inline-flex min-h-11 sm:min-h-9 items-center gap-1.5 rounded-[10px] bg-primary px-3.5 py-1.5 text-xs font-semibold text-on-primary shadow-2xs hover:bg-primary-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary transition shrink-0" do %>
      <span class="h-2 w-2 shrink-0 rounded-full bg-white animate-pulse" aria-hidden="true"></span>
      <%= material_icon("videocam", size: 15) %>
      <span>Gabung Room</span>
      <span class="rounded-[6px] bg-white/20 px-1.5 py-0.5 font-mono text-[10px] font-semibold"><%= active_meeting.room_code %></span>
    <% end %>
  <% else %>
    <%= form_with model: [project, (local_assigns[:new_meeting] || project.meetings.build)], class: "flex flex-wrap sm:flex-nowrap items-center gap-1.5" do |form| %>
      <%= form.text_field :title,
        required: true,
        placeholder: "Judul rapat...",
        value: "Sync Diskusi #{project.key}",
        aria: { label: "Judul rapat baru" },
        class: "min-h-11 sm:min-h-9 w-40 sm:w-44 rounded-[10px] border border-outline-variant bg-input px-2.5 py-1.5 text-xs text-on-surface placeholder:text-on-surface-muted focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/25" %>
      <%= button_tag type: "submit", class: "inline-flex min-h-11 sm:min-h-9 items-center gap-1.5 rounded-[10px] bg-primary px-3 py-1.5 text-xs font-semibold text-on-primary shadow-2xs hover:bg-primary-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary transition cursor-pointer shrink-0" do %>
        <%= material_icon("videocam", size: 15) %>
        <span>Buka Room</span>
      <% end %>
    <% end %>
  <% end %>
</div>
