<div id="<%= dom_id(project, :kanban_board) %>"
     data-controller="kanban"
     class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
  <% column_themes = {
    "todo" => { header: "bg-slate-100 text-slate-800", dot: "bg-slate-500", border: "border-slate-200" },
    "in_progress" => { header: "bg-indigo-50 text-indigo-900", dot: "bg-indigo-600", border: "border-indigo-200/80" },
    "review" => { header: "bg-amber-50 text-amber-900", dot: "bg-amber-500", border: "border-amber-200/80" },
    "done" => { header: "bg-emerald-50 text-emerald-900", dot: "bg-emerald-600", border: "border-emerald-200/80" }
  } %>

  <% Task::COLUMNS.each do |column_key, column_label| %>
    <% column_tasks = tasks_by_column.fetch(column_key, []) %>
    <% theme = column_themes.fetch(column_key) %>

    <section data-kanban-target="column"
             data-column="<%= column_key %>"
             data-action="dragover->kanban#dragOver dragleave->kanban#dragLeave drop->kanban#drop"
             class="flex min-h-[340px] flex-col rounded-2xl border <%= theme[:border] %> bg-slate-50/90 transition-colors">
      <div class="flex items-center justify-between rounded-t-2xl border-b border-slate-200/80 <%= theme[:header] %> px-4 py-3">
        <div class="flex items-center gap-2">
          <span class="h-2.5 w-2.5 rounded-full <%= theme[:dot] %>"></span>
          <h3 class="text-sm font-bold"><%= column_label %></h3>
        </div>
        <span class="inline-flex h-6 min-w-6 items-center justify-center rounded-full bg-white px-2 text-xs font-bold text-slate-700 shadow-2xs">
          <%= column_tasks.size %>
        </span>
      </div>

      <div data-kanban-target="list" class="flex-1 space-y-3 p-3">
        <% if column_tasks.any? %>
          <% column_tasks.each do |task| %>
            <%= render "tasks/card", project: project, task: task %>
          <% end %>
        <% else %>
          <div class="rounded-xl border border-dashed border-slate-300/80 bg-white/50 p-4 text-center text-xs text-slate-400">
            Drop task ke kolom <%= column_label %>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>
</div>

