<div id="<%= dom_id(project, :kanban_board) %>"
     data-controller="kanban"
     class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-4 items-start">
  <% column_dots = {
    "todo" => "bg-on-surface-muted",
    "in_progress" => "bg-on-surface",
    "review" => "bg-warning",
    "done" => "bg-primary"
  } %>

  <% Task::COLUMNS.each do |column_key, column_label| %>
    <% column_tasks = tasks_by_column.fetch(column_key, []) %>

    <section data-kanban-target="column"
             data-column="<%= column_key %>"
             data-action="dragover->kanban#dragOver dragleave->kanban#dragLeave drop->kanban#drop"
             class="flex min-h-[260px] flex-col rounded-[12px] border border-outline-variant bg-column transition-colors">
      <div class="flex items-center justify-between border-b border-outline-variant/80 px-3.5 py-2.5">
        <div class="flex items-center gap-2">
          <span class="h-2 w-2 rounded-full <%= column_dots.fetch(column_key, 'bg-on-surface-muted') %>" aria-hidden="true"></span>
          <h3 class="font-display text-sm font-semibold text-on-surface"><%= column_label %></h3>
        </div>
        <span class="inline-flex h-5 min-w-5 items-center justify-center rounded-full border border-outline-variant bg-inset px-1.5 font-mono text-[11px] font-semibold text-on-surface-variant">
          <%= column_tasks.size %>
        </span>
      </div>

      <div data-kanban-target="list" class="flex-1 space-y-2.5 p-2.5">
        <% if column_tasks.any? %>
          <% column_tasks.each do |task| %>
            <%= render "tasks/card", project: project, task: task %>
          <% end %>
        <% else %>
          <div class="rounded-[10px] border border-dashed border-outline-variant bg-card/40 p-4 text-center text-[11px] text-on-surface-muted">
            Drop task di <%= column_label %>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
