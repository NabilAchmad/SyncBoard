<% content_for :title, "Workspace | SyncBoard" %>
<% content_for :page_title, current_team ? current_team.name : "Workspace" %>
<% content_for :full_bleed, "true" %>

<% if current_team.nil? %>
  <div class="mx-auto w-full max-w-4xl px-4 py-6 sm:px-6 lg:px-8 space-y-5">
    <div class="rounded-[12px] border border-outline-variant bg-panel p-6 shadow-2xs">
      <p class="text-[11px] font-semibold uppercase tracking-wider text-on-surface-muted"><%= greeting_text %>, <%= current_user.full_name %></p>
      <h2 class="mt-1 font-display text-xl font-semibold tracking-tight text-on-surface">Workspace Anda Masih Kosong</h2>
      <p class="mt-1.5 text-xs text-on-surface-variant">
        Gabung tim menggunakan kode undangan 6 karakter, atau buat tim baru.
      </p>
    </div>

    <div class="grid gap-5 md:grid-cols-2">
      <div class="rounded-[12px] border border-outline-variant bg-card p-5 sm:p-6 space-y-4">
        <div>
          <h3 class="font-display text-base font-semibold text-on-surface">Gabung dengan Kode</h3>
          <p class="mt-0.5 text-xs text-on-surface-muted">Kode undangan 6 karakter dari Team Lead.</p>
        </div>

        <%= form_with url: join_teams_path, method: :post, class: "space-y-4" do %>
          <div>
            <%= label_tag :invite_code, "Kode Undangan", class: "sr-only" %>
            <%= text_field_tag :invite_code, nil,
              required: true,
              maxlength: 6,
              autocomplete: "off",
              placeholder: "A7K9P2",
              class: ui_input_class("py-3 text-center font-mono text-lg font-semibold uppercase tracking-[0.35em] rounded-[12px]") %>
          </div>

          <%= submit_tag "Gabung ke Tim", class: ui_btn_primary_class("w-full py-2.5 rounded-[12px]") %>
        <% end %>
      </div>

      <div class="rounded-[12px] border border-outline-variant bg-card p-5 sm:p-6 space-y-4">
        <div>
          <h3 class="font-display text-base font-semibold text-on-surface">Buat Tim Baru</h3>
          <p class="mt-0.5 text-xs text-on-surface-muted">Otomatis menjadi Team Lead &amp; mendapat kode undangan.</p>
        </div>

        <%= form_with model: (@new_team || Team.new), url: teams_path, class: "space-y-3" do |form| %>
          <div>
            <%= form.label :name, "Nama Tim", class: ui_label_class("text-xs") %>
            <%= form.text_field :name,
              required: true,
              placeholder: "Misal: Tim Backend Squad",
              class: ui_input_class("mt-1 py-2 rounded-[12px]") %>
          </div>

          <div>
            <%= form.label :description, "Deskripsi (Opsional)", class: ui_label_class("text-xs") %>
            <%= form.text_field :description,
              placeholder: "Fokus tim...",
              class: ui_input_class("mt-1 py-2 rounded-[12px]") %>
          </div>

          <div class="pt-1">
            <%= form.submit "Buat Tim & Dapatkan Kode", class: ui_btn_secondary_class("w-full py-2.5 text-sm rounded-[12px]") %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% else %>
  <div class="flex flex-1 flex-col">
    <div class="flex flex-col gap-3 border-b border-outline-variant bg-panel px-4 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-6">
      <div class="flex flex-wrap items-center gap-2.5 min-w-0">
        <h2 class="font-display text-lg font-semibold tracking-tight text-on-surface">Kelola Proyek & Board</h2>
        <span class="inline-flex items-center rounded-full border border-outline-variant bg-inset px-2.5 py-0.5 font-mono text-[11px] font-medium text-on-surface-variant">
          <%= @projects.size %> Proyek
        </span>
        <span class="inline-flex items-center rounded-full border border-outline-variant bg-inset px-2.5 py-0.5 font-mono text-[11px] font-medium text-on-surface-muted">
          <%= @team_memberships.size %> Anggota
        </span>
      </div>

      <div class="flex flex-wrap items-center gap-2 shrink-0">
        <% if current_team_lead? %>
          <div class="inline-flex min-h-11 sm:min-h-9 items-center gap-2 rounded-[10px] border border-outline-variant bg-card pl-3 pr-1 py-1">
            <span class="text-xs text-on-surface-muted">Kode Tim</span>
            <span class="font-mono text-xs font-semibold tracking-widest text-on-surface"><%= current_team.invite_code %></span>
            <button type="button"
                    data-action="sidebar#copyCode"
                    data-code="<%= current_team.invite_code %>"
                    class="inline-flex min-h-9 sm:min-h-7 items-center rounded-[7px] bg-inset px-2 text-xs font-semibold text-primary-text hover:bg-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary transition cursor-pointer">
              Salin
            </button>
          </div>
        <% end %>

        <%= link_to new_project_path, class: "inline-flex min-h-11 sm:min-h-9 items-center gap-1.5 rounded-[10px] bg-primary px-3.5 py-1.5 text-xs font-semibold text-on-primary shadow-2xs transition hover:bg-primary-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary" do %>
          <%= material_icon("add", size: 16) %>
          <span>Buat Proyek Baru</span>
        <% end %>
      </div>
    </div>

    <div class="flex flex-1 flex-col lg:flex-row">
      <div class="flex-1 min-w-0 p-4 sm:p-6">
        <% if @projects.any? %>
          <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
            <% @projects.each do |project| %>
              <% counts = project.task_counts_by_column %>
              <% total_tasks = counts.values.sum %>
              <% done_pct = total_tasks.positive? ? ((counts["done"].to_f / total_tasks) * 100).round : 0 %>
              <% active_meeting = project.active_meeting %>
              <% latest_meeting = active_meeting || project.meetings.max_by { |m| [ m.started_at, m.id ] } %>

              <article class="flex flex-col justify-between rounded-[12px] border border-outline-variant bg-card p-5 shadow-2xs transition hover:border-outline">
                <div>
                  <div class="flex items-start justify-between gap-2">
                    <div class="flex min-w-0 items-center gap-2">
                      <span class="shrink-0 rounded-[6px] border border-primary-border bg-primary-soft px-2 py-0.5 font-mono text-[11px] font-semibold text-on-primary-soft">
                        <%= project.key %>
                      </span>
                      <% if project.completed? %>
                        <span class="shrink-0 rounded-[6px] border border-primary-border bg-primary-soft px-2 py-0.5 text-[10px] font-semibold text-on-primary-soft">
                          Selesai
                        </span>
                      <% end %>
                      <h3 class="truncate font-display text-base font-semibold text-on-surface">
                        <%= link_to project.name, project_path(project), class: "rounded hover:text-primary-text focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary" %>
                      </h3>
                    </div>

                    <span class="shrink-0 text-[11px] text-on-surface-muted">Lead: <%= project.owner.full_name %></span>
                  </div>

                  <p class="mt-2 line-clamp-2 text-xs leading-relaxed text-on-surface-variant">
                    <%= project.description.presence || "Workspace kolaborasi tim, Kanban board, dan ruang rapat video." %>
                  </p>

                  <div class="mt-4 grid grid-cols-4 gap-2 rounded-[10px] border border-outline-variant/80 bg-inset px-2 py-2 text-center">
                    <div>
                      <p class="text-[10px] font-semibold uppercase tracking-wider text-on-surface-muted">To Do</p>
                      <p class="mt-0.5 font-mono text-sm font-semibold tabular-nums text-on-surface"><%= counts["todo"] %></p>
                    </div>
                    <div>
                      <p class="text-[10px] font-semibold uppercase tracking-wider text-on-surface-muted">Progress</p>
                      <p class="mt-0.5 font-mono text-sm font-semibold tabular-nums text-on-surface"><%= counts["in_progress"] %></p>
                    </div>
                    <div>
                      <p class="text-[10px] font-semibold uppercase tracking-wider text-on-surface-muted">Review</p>
                      <p class="mt-0.5 font-mono text-sm font-semibold tabular-nums text-on-warning-soft"><%= counts["review"] %></p>
                    </div>
                    <div>
                      <p class="text-[10px] font-semibold uppercase tracking-wider text-on-surface-muted">Done</p>
                      <p class="mt-0.5 font-mono text-sm font-semibold tabular-nums text-primary-text"><%= counts["done"] %></p>
                    </div>
                  </div>

                  <div class="mt-3.5 space-y-1.5">
                    <div class="flex items-center justify-between text-[11px]">
                      <span class="text-on-surface-muted">Progres selesai</span>
                      <span class="font-mono font-semibold text-on-surface"><%= done_pct %>% (<%= counts["done"] %>/<%= total_tasks %>)</span>
                    </div>
                    <div class="h-1.5 w-full overflow-hidden rounded-full bg-inset" role="progressbar" aria-valuenow="<%= done_pct %>" aria-valuemin="0" aria-valuemax="100" aria-label="Progres task selesai proyek <%= project.name %>">
                      <div class="h-full rounded-full bg-primary transition-all" style="width: <%= done_pct %>%"></div>
                    </div>
                  </div>
                </div>

                <div class="mt-4 flex flex-wrap items-center justify-between gap-2 border-t border-outline-variant pt-3.5">
                  <div class="flex items-center gap-2 min-w-0">
                    <%= user_avatar(project.owner, size_class: "w-6 h-6", text_class: "text-[10px]", lead: true, team: current_team) %>
                    <% if latest_meeting %>
                      <%= link_to project_meeting_path(project, latest_meeting),
                        class: "inline-flex min-h-9 sm:min-h-7 items-center gap-1 rounded-[7px] border px-2 py-0.5 font-mono text-[11px] font-medium focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary transition #{latest_meeting.call_open? ? 'border-primary-border bg-primary-soft text-on-primary-soft hover:bg-primary-soft/80' : 'border-outline-variant bg-inset text-on-surface-variant hover:border-outline hover:bg-hover hover:text-on-surface'}" do %>
                        <% if latest_meeting.call_open? %>
                          <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-danger animate-pulse" aria-hidden="true"></span>
                          <span>Gabung Room · <%= latest_meeting.room_code %></span>
                        <% else %>
                          <%= material_icon("videocam", size: 13, extra_class: "text-primary-text") %>
                          <span><%= latest_meeting.room_code %></span>
                        <% end %>
                      <% end %>
                    <% end %>
                  </div>

                  <%= link_to project_path(project), class: "inline-flex min-h-11 sm:min-h-8 items-center gap-1 rounded-[8px] border border-outline-variant bg-panel px-2.5 py-1 text-xs font-semibold text-on-surface hover:border-outline hover:bg-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary transition" do %>
                    <span>Buka</span>
                    <%= material_icon("arrow_forward", size: 14) %>
                  <% end %>
                </div>
              </article>
            <% end %>
          </div>
        <% else %>
          <div class="rounded-[12px] border border-dashed border-outline bg-panel p-10 text-center">
            <p class="font-display text-base font-semibold text-on-surface">Belum ada proyek di tim <%= current_team.name %>.</p>
            <p class="mt-1.5 text-xs text-on-surface-variant">Buat proyek pertama tim Anda untuk mulai menyusun Kanban Board &amp; ruang meeting.</p>
            <%= link_to "Buat Proyek Pertama", new_project_path, class: ui_btn_primary_class("mt-5 text-xs") %>
          </div>
        <% end %>
      </div>

      <aside class="flex w-full shrink-0 flex-col justify-between border-t border-outline-variant bg-panel lg:w-[300px] lg:border-l lg:border-t-0 xl:w-[320px]">
        <div class="p-5 space-y-4">
          <div class="flex items-center justify-between">
            <h3 class="text-[11px] font-semibold uppercase tracking-wider text-on-surface-muted">Aktivitas Terbaru</h3>
            <span class="font-mono text-[10px] text-on-surface-muted"><%= @recent_logs.size %></span>
          </div>

          <% if @recent_logs.any? %>
            <ul class="space-y-3">
              <% @recent_logs.each do |log| %>
                <li class="flex items-start gap-2.5 text-xs">
                  <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-primary"></span>
                  <div class="min-w-0 flex-1">
                    <p class="leading-relaxed text-on-surface"><%= log.summary %></p>
                    <p class="mt-0.5 font-mono text-[10px] text-on-surface-muted">
                      <%= log.project.key %> · <%= log.created_at.strftime("%d %b %H:%M") %>
                    </p>
                  </div>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="text-xs text-on-surface-muted">Belum ada aktivitas terbaru di tim ini.</p>
          <% end %>
        </div>

        <div class="border-t border-outline-variant bg-inset/60 p-5 space-y-3">
          <h3 class="text-[11px] font-semibold uppercase tracking-wider text-on-surface-muted">Anggota Tim (<%= @team_memberships.size %>)</h3>
          <ul class="space-y-2.5">
            <% @team_memberships.each do |membership| %>
              <% member = membership.user %>
              <li class="flex items-center justify-between gap-2">
                <div class="flex min-w-0 items-center gap-2">
                  <%= user_avatar(member, size_class: "w-7 h-7", text_class: "text-[10px]", lead: membership.lead?) %>
                  <div class="min-w-0">
                    <p class="truncate text-xs font-semibold text-on-surface"><%= member.full_name %></p>
                    <p class="truncate text-[10px] text-on-surface-muted"><%= member.job_title %></p>
                  </div>
                </div>
                <span class="shrink-0 rounded-md border px-1.5 py-0.5 text-[10px] font-semibold <%= membership.lead? ? 'border-primary-border bg-primary-soft text-on-primary-soft' : 'border-outline-variant bg-card text-on-surface-variant' %>">
                  <%= membership.lead? ? "Lead" : "Member" %>
                </span>
              </li>
            <% end %>
          </ul>
        </div>
      </aside>
    </div>
  </div>
<% end %>
