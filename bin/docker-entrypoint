#!/bin/bash -e

# If running the rails server then create or migrate existing database (skip on serverless cold starts)
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ] && [ -z "${VERCEL:-}" ] && [ -z "${VERCEL_ENV:-}" ] && [ "${SKIP_DB_PREPARE:-}" != "true" ]; then
  ./bin/rails db:prepare
fi

exec "${@}"
