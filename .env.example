# SyncBoard Environment Variables Template
# Salin file ini menjadi `.env` (jangan commit `.env` ke git) lalu isi nilainya.

# === Database Neon (PostgreSQL) ===
# Gunakan connection string dari dashboard Neon Anda (wajib ?sslmode=require).
# Contoh pooled URL atau direct URL:
# DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-xxxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# === Rails / Production ===
# Diambil dari config/master.key (diperlukan saat deploy container/PaaS)
RAILS_MASTER_KEY=
APP_HOST=localhost
APP_PROTOCOL=http
ASSUME_SSL=false
FORCE_SSL=false
SOLID_QUEUE_IN_PUMA=true
SOLID_CABLE_POLLING_INTERVAL=0.2

# Opsional: origin WebSocket tambahan (pisahkan koma) bila memakai custom domain / CDN
# ACTION_CABLE_ALLOWED_ORIGINS=https://domain-anda.com,https://www.domain-anda.com

# === AI Summary (Opsional) ===
# Jika diisi, ringkasan rapat memakai Google Gemini API; jika kosong memakai parser lokal bawaan.
GEMINI_API_KEY=

# === WebRTC TURN Server (Opsional untuk jaringan seluler/kantor dengan NAT ketat) ===
# Bisa memakai Metered, Twilio, Cloudflare Calls, atau coturn sendiri:
# TURN_URL=turn:turn.domain-anda.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=
# Atau JSON array penuh:
# WEBRTC_ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:...","username":"...","credential":"..."}]

# === Bootstrap Team Lead via CLI (`rails db:seed`) ===
# Opsional: atau langsung daftar lewat `/registration/new` pada database kosong untuk auto Team Lead.
# SYNCBOARD_LEAD_EMAIL=lead@perusahaan.com
# SYNCBOARD_LEAD_PASSWORD=GantiPasswordKuat123!
# SYNCBOARD_LEAD_NAME=Team Lead
# SYNCBOARD_LEAD_DEPARTMENT=Engineering
# SYNCBOARD_LEAD_TITLE=Engineering Lead

# === Email Reset Password SMTP (Opsional) ===
# MAILER_FROM=SyncBoard <noreply@domain-anda.com>
# SMTP_ADDRESS=smtp.resend.com
# SMTP_PORT=587
# SMTP_DOMAIN=domain-anda.com
# SMTP_USERNAME=resend
# SMTP_PASSWORD=

